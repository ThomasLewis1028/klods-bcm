<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Klods.Mobile.Pages.MySetsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <Label Grid.Column="0"
                       Text="My Sets"
                       FontSize="26"
                       FontAttributes="Bold"
                       Margin="16,16,16,8" />
                <Button x:Name="ListViewBtn"
                        Grid.Column="1"
                        Text="&#xe8ef;"
                        FontFamily="MaterialIcons"
                        FontSize="22"
                        WidthRequest="44" HeightRequest="44"
                        CornerRadius="0" Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        Clicked="OnListViewClicked" />
                <Button x:Name="GridViewBtn"
                        Grid.Column="2"
                        Text="&#xe8f0;"
                        FontFamily="MaterialIcons"
                        FontSize="22"
                        WidthRequest="44" HeightRequest="44"
                        CornerRadius="0" Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray400}"
                        Clicked="OnGridViewClicked"
                        Margin="0,0,8,0" />
            </Grid>
            <Entry Grid.Row="1"
                   Placeholder="Search sets…"
                   Margin="16,0,16,8"
                   TextChanged="OnSearchTextChanged"
                   ClearButtonVisibility="WhileEditing" />
        </Grid>

        <Grid Grid.Row="1">

            <ActivityIndicator x:Name="Loader"
                               IsRunning="True"
                               IsVisible="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{DynamicResource Primary}" />

            <VerticalStackLayout x:Name="ErrorView"
                                 IsVisible="False"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16"
                                 Padding="32">
                <Label x:Name="ErrorLabel"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Button Text="Retry"
                        HorizontalOptions="Center"
                        Clicked="OnRetryClicked" />
            </VerticalStackLayout>

            <!-- List view -->
            <RefreshView x:Name="Refresher"
                         Refreshing="OnRefreshing"
                         IsVisible="False"
                         VerticalOptions="Fill">
                <CollectionView x:Name="SetsList"
                                Margin="0,0,0,80"
                                SelectionMode="Single"
                                SelectionChanged="OnSetSelected"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReached="OnLoadMore">

                    <CollectionView.EmptyView>
                        <Label Text="No sets in your collection yet."
                               TextColor="{StaticResource Gray400}"
                               FontSize="15"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,60,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    Margin="16,4"
                                    StrokeShape="RoundRectangle 10">

                                <Grid ColumnDefinitions="88,*" ColumnSpacing="12">

                                    <Border Grid.Column="0"
                                            WidthRequest="80" HeightRequest="80"
                                            BackgroundColor="{DynamicResource Secondary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                        <Image Source="{Binding SetImg}"
                                               Aspect="AspectFill"
                                               WidthRequest="80" HeightRequest="80" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Label Text="{Binding SubtitleLine1}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding PiecesLabel}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray400}" />
                                        <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                            <Border Padding="8,3"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{DynamicResource Primary}"
                                                    Stroke="Transparent">
                                                <Label Text="{Binding CopiesLabel}"
                                                       FontSize="11"
                                                       TextColor="White" />
                                            </Border>
                                            <Label Text="{Binding MissingLabel}"
                                                   FontSize="12"
                                                   TextColor="#F59E0B"
                                                   IsVisible="{Binding HasMissing}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <!-- Grid view -->
            <RefreshView x:Name="GridRefresher"
                         Refreshing="OnRefreshing"
                         IsVisible="False"
                         VerticalOptions="Fill">
                <CollectionView x:Name="GridList"
                                Margin="12,0,12,80"
                                SelectionMode="Single"
                                SelectionChanged="OnSetSelected"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReached="OnLoadMore">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         HorizontalItemSpacing="8"
                                         VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label Text="No sets in your collection yet."
                               TextColor="{StaticResource Gray400}"
                               FontSize="15"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,60,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                                    Margin="0,0"
                                    StrokeShape="RoundRectangle 10">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Border Grid.Row="0"
                                            HeightRequest="100"
                                            BackgroundColor="{DynamicResource Secondary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8">
                                        <Image Source="{Binding SetImg}" Aspect="AspectFill" />
                                    </Border>
                                    <Label Grid.Row="1"
                                           Text="{Binding Name}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="0,2,0,0" />
                                    <Border Grid.Row="2"
                                            Padding="6,2"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource Primary}"
                                            Stroke="Transparent"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding CopiesLabel}"
                                               FontSize="10"
                                               TextColor="White" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <!-- FAB -->
            <Button Text="&#xe145;"
                    FontFamily="MaterialIcons"
                    FontSize="28"
                    WidthRequest="56" HeightRequest="56"
                    CornerRadius="28"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,24,24"
                    Clicked="OnImportClicked" />

        </Grid>

    </Grid>

</ContentPage>
