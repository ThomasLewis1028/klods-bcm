<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Klods.Mobile.Pages.MinifigsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <Label Grid.Column="0"
                       Text="Minifigs"
                       FontSize="26"
                       FontAttributes="Bold"
                       Margin="16,16,16,8" />
                <Button x:Name="ListViewBtn"
                        Grid.Column="1"
                        Text="&#xe8ef;"
                        FontFamily="MaterialIcons"
                        FontSize="22"
                        WidthRequest="44" HeightRequest="44"
                        CornerRadius="0" Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        Clicked="OnListViewClicked" />
                <Button x:Name="GridViewBtn"
                        Grid.Column="2"
                        Text="&#xe8f0;"
                        FontFamily="MaterialIcons"
                        FontSize="22"
                        WidthRequest="44" HeightRequest="44"
                        CornerRadius="0" Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray400}"
                        Clicked="OnGridViewClicked"
                        Margin="0,0,8,0" />
            </Grid>
            <Entry Grid.Row="1"
                   Placeholder="Search minifigs…"
                   Margin="16,0,16,8"
                   TextChanged="OnSearchTextChanged"
                   ClearButtonVisibility="WhileEditing" />
        </Grid>

        <Grid Grid.Row="1">

            <ActivityIndicator x:Name="Loader"
                               IsRunning="True"
                               IsVisible="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <VerticalStackLayout x:Name="ErrorView"
                                 IsVisible="False"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16" Padding="32">
                <Label x:Name="ErrorLabel"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Button Text="Retry" HorizontalOptions="Center" Clicked="OnRetryClicked" />
            </VerticalStackLayout>

            <!-- List view -->
            <RefreshView x:Name="Refresher"
                         Refreshing="OnRefreshing"
                         IsVisible="False"
                         VerticalOptions="Fill">
                <CollectionView x:Name="MinifigsList"
                                SelectionMode="None"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReached="OnLoadMore">

                    <CollectionView.EmptyView>
                        <Label Text="No minifigs in the catalog yet."
                               TextColor="{StaticResource Gray400}"
                               FontSize="15"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,60,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,3" Padding="12,10" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="60,*" ColumnSpacing="12">

                                    <Border Grid.Column="0"
                                            WidthRequest="56" HeightRequest="56"
                                            BackgroundColor="{DynamicResource Secondary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                        <Image Source="{Binding ImgUrl}"
                                               Aspect="AspectFit"
                                               WidthRequest="56" HeightRequest="56" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Label Text="{Binding SubtitleLine}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray400}" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <!-- Grid view -->
            <RefreshView x:Name="GridRefresher"
                         Refreshing="OnRefreshing"
                         IsVisible="False"
                         VerticalOptions="Fill">
                <CollectionView x:Name="GridList"
                                Margin="12,0"
                                SelectionMode="None"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReached="OnLoadMore">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         HorizontalItemSpacing="8"
                                         VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label Text="No minifigs in the catalog yet."
                               TextColor="{StaticResource Gray400}"
                               FontSize="15"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,60,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                                    StrokeShape="RoundRectangle 10">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Border Grid.Row="0"
                                            HeightRequest="100"
                                            BackgroundColor="{DynamicResource Secondary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8">
                                        <Image Source="{Binding ImgUrl}" Aspect="AspectFit" />
                                    </Border>
                                    <Label Grid.Row="1"
                                           Text="{Binding Name}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="0,2,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
