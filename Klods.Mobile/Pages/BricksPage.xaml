<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Klods.Mobile.Pages.BricksPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
            <Label Grid.Column="0"
                   Text="Bricks"
                   FontSize="26"
                   FontAttributes="Bold"
                   Margin="16,16,16,8" />
            <Button x:Name="ListViewBtn"
                    Grid.Column="1"
                    Text="&#xe8ef;"
                    FontFamily="MaterialIcons"
                    FontSize="22"
                    WidthRequest="44" HeightRequest="44"
                    CornerRadius="0" Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Primary}"
                    Clicked="OnListViewClicked" />
            <Button x:Name="GridViewBtn"
                    Grid.Column="2"
                    Text="&#xe8f0;"
                    FontFamily="MaterialIcons"
                    FontSize="22"
                    WidthRequest="44" HeightRequest="44"
                    CornerRadius="0" Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Gray400}"
                    Clicked="OnGridViewClicked"
                    Margin="0,0,8,0" />
        </Grid>

        <Grid Grid.Row="1">

            <ActivityIndicator x:Name="Loader"
                               IsRunning="True"
                               IsVisible="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <VerticalStackLayout x:Name="ErrorView"
                                 IsVisible="False"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16" Padding="32">
                <Label x:Name="ErrorLabel"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Button Text="Retry" HorizontalOptions="Center" Clicked="OnRetryClicked" />
            </VerticalStackLayout>

            <!-- List view -->
            <RefreshView x:Name="Refresher"
                         Refreshing="OnRefreshing"
                         IsVisible="False"
                         VerticalOptions="Fill">
                <CollectionView x:Name="BricksList"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Label Text="No bricks in the catalog yet."
                               TextColor="{StaticResource Gray400}"
                               FontSize="15"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,60,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,3" Padding="12,10" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="10">

                                    <Border Grid.Column="0"
                                            WidthRequest="48" HeightRequest="48"
                                            BackgroundColor="{DynamicResource Secondary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                        <Image Source="{Binding PartImgUrl}"
                                               Aspect="AspectFit"
                                               WidthRequest="48" HeightRequest="48" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Ellipse Fill="{Binding SwatchBrush}"
                                                     WidthRequest="12" HeightRequest="12"
                                                     VerticalOptions="Center" />
                                            <Label Text="{Binding ColorName}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray400}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding StatsLabel}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray400}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding SetCountLabel}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray400}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <!-- Grid view -->
            <RefreshView x:Name="GridRefresher"
                         Refreshing="OnRefreshing"
                         IsVisible="False"
                         VerticalOptions="Fill">
                <CollectionView x:Name="GridList"
                                Margin="12,0"
                                SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         HorizontalItemSpacing="8"
                                         VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label Text="No bricks in the catalog yet."
                               TextColor="{StaticResource Gray400}"
                               FontSize="15"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,60,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                                    StrokeShape="RoundRectangle 10">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Border Grid.Row="0"
                                            HeightRequest="80"
                                            BackgroundColor="{DynamicResource Secondary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8">
                                        <Image Source="{Binding PartImgUrl}" Aspect="AspectFit" />
                                    </Border>
                                    <Label Grid.Row="1"
                                           Text="{Binding Name}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="0,2,0,0" />
                                    <HorizontalStackLayout Grid.Row="2" Spacing="4">
                                        <Ellipse Fill="{Binding SwatchBrush}"
                                                 WidthRequest="10" HeightRequest="10"
                                                 VerticalOptions="Center" />
                                        <Label Text="{Binding ColorName}"
                                               FontSize="10"
                                               TextColor="{StaticResource Gray400}"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
