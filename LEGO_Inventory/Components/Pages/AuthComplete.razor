@page "/auth/complete"
@inject AuthService AuthService
@inject ThemeService ThemeService
@inject ApiClient Api
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage LocalStorage
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@* Silent handoff page — restores the session after an OAuth redirect. *@

@code {
    [SupplyParameterFromQuery] private string? Token  { get; set; }
    [SupplyParameterFromQuery] private bool    Linked { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var jwt = Token is not null ? await Api.ExchangePendingTokenAsync(Token) : null;
        if (jwt is not null)
        {
            // Bootstrap the token so ApiClient can make the profile call.
            AuthService.SetSession(new UserInfo(0, "", "User", null, null, false), jwt);

            var profile = await Api.GetMyProfileAsync();
            if (profile is not null)
            {
                var user = new UserInfo(profile.UserId, profile.UserName, profile.Role,
                    profile.ProfilePictureUrl, profile.PrimaryColor, profile.HasPassword);
                AuthService.SetSession(user, jwt);
                try { await LocalStorage.SetAsync("jwt", jwt); } catch { }

                if (profile.PrimaryColor is not null)
                    ThemeService.SetPrimaryColor(profile.PrimaryColor);
            }
        }

        Nav.NavigateTo(Linked ? "/profile?linked=true" : "/");
    }
}
