# Klods — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Values marked (required) must be set; everything else has a sensible default.

# ─── Rebrickable API ──────────────────────────────────────────────────────────
# (required) Personal API key from https://rebrickable.com/api/
# Used to pull the catalog (sets, parts, minifigs) and images.
REBRICKABLE_API_KEY=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# POSTGRES_HOST: leave as "postgres" (the Compose service name) for Docker.
# Only change it to a host:port when running the app outside Compose.
POSTGRES_HOST=postgres
POSTGRES_USER=klods
POSTGRES_PASSWORD=            # (required) set a strong password
POSTGRES_DB=klods_database

# ─── MinIO object storage (brick/set image cache) ─────────────────────────────
MINIO_ROOT_USER=klods
MINIO_ROOT_PASSWORD=         # (required) set a strong password

# ─── Public URLs ──────────────────────────────────────────────────────────────
# Where the browser reaches the web app and the API. The localhost values below
# are fine for a local run. For a real deployment set BOTH to your public URLs —
# compose.ghcr.yaml treats them as REQUIRED and refuses to start if either is
# unset (a missing value would silently redirect users to their own localhost).
# BLAZOR_ORIGIN  = public URL of the web app (klods_web).
# API_PUBLIC_URL = public URL the browser uses to reach the API (klods_api);
#                  register {API_PUBLIC_URL}/signin-<provider> in each OAuth console.
BLAZOR_ORIGIN=http://localhost:5100
API_PUBLIC_URL=http://localhost:5101

# ─── Security ─────────────────────────────────────────────────────────────────
# (required) Long random string for signing auth tokens. Must be at least 32 bytes —
# the API refuses to start with anything shorter, since a weak secret lets anyone forge tokens.
# Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=

# Comma-separated CIDR ranges of reverse proxies allowed to set X-Forwarded-For/Host/Proto
# (e.g. your Docker bridge subnet, or the proxy container's address). Leave unset unless you're
# running behind a reverse proxy — without it, ASP.NET Core only trusts loopback, so a direct
# client can't spoof its IP/host to dodge rate limiting. Example: TRUSTED_PROXY_NETWORKS=172.20.0.0/16
TRUSTED_PROXY_NETWORKS=

# Initial admin account — created on first startup ONLY (when no admin exists).
# ADMIN_USERNAME defaults to "admin" if omitted.
# Leave ADMIN_DEFAULT_PASSWORD blank to have a strong password generated and
# printed once in the container logs (`docker logs klods_api`). Setting this
# later does NOT rotate an existing admin — change the password in-app instead.
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=

# ─── OAuth sign-in providers (all optional) ───────────────────────────────────
# Fill in only the providers you want to offer. A provider with a blank id or
# secret is skipped and hidden from the login screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── pgAdmin (optional DB web UI at http://localhost:8888) ─────────────────────
# Used only by the bundled "pgwebadmin" container. If you don't want a database
# UI, remove this block and the pgwebadmin service from compose.yaml.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=    # set if you keep pgwebadmin
