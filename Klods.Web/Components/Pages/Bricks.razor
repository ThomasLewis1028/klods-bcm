@page "/bricks"
@inject ILoggerFactory LoggerFactory
@inject IDialogService DialogService
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Components.Objects
@using Klods.Services
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@rendermode InteractiveServer

<PageTitle>Bricks</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">Bricks</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    @* Stats *@
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalBricks.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Bricks in Catalog</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalOwnedStock.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Owned Stock</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* Search *@
    <MudItem xs="12">
        <MudTextField T="string" Value="_query" ValueChanged="OnQueryChanged"
                      Immediate="true" DebounceInterval="350"
                      Placeholder="Search by part number, name, or color — or just browse the most-used below…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Clearable="true"/>
    </MudItem>

    @* Catalog (server-paginated; most-used bricks by default) *@
    <MudItem xs="12">
        <MudDataGrid T="BrickInfo" @ref="_grid" ServerData="LoadServerData"
                     SortMode="SortMode.None" ReadOnly="true">
            <Columns>
                <HierarchyColumn T="BrickInfo" ButtonDisabledFunc="@(info => info.Brick.SetCount == 0)"/>
                <TemplateColumn Title="Image" Editable="false">
                    <CellTemplate>
                        <MudStack Row>
                            <MudImage class="cursor-pointer rounded-3" Elevation="2" Src="@ImageStorage.ResolveUrl(context.Item.Brick.PartImg)"
                                      Height="50"
                                      @onclick="() => OpenImagePopup(context.Item.Brick.PartNum, context.Item.Brick.Name, ImageStorage.ResolveUrl(context.Item.Brick.PartImg))"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Brick.PartNum" Title="Id" Editable="false"/>
                <PropertyColumn Property="x => x.Brick.Name" Title="Name" Editable="false"/>
                <TemplateColumn Title="Color" Editable="false">
                    <CellTemplate>
                        <MudStack Row>
                            @if (context.Item.Brick.HexColor != null)
                            {
                                <MudChip OnClick="() => OpenColorPopup(context.Item.Brick.HexColor, context.Item.Brick.ColorName)"
                                         class="mud-elevation-2"
                                         Style="@ColorHelper.ColorChipStyle(context.Item.Brick.HexColor)">
                                    @context.Item.Brick.ColorName
                                </MudChip>
                            }
                            else
                            {
                                <MudChip Color="default">N/A</MudChip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Brick.TotalStock" Title="Stock" Editable="false"/>
                <PropertyColumn Property="x => x.Brick.TotalNeeded" Title="Needed" Editable="false"/>
                <PropertyColumn Property="x => x.Brick.SetCount" Title="Sets" Editable="false"/>
            </Columns>

            <ChildRowContent Context="brickContext">
                <div class="child-row-content">
                @if (!brickContext.Item.IsLoaded)
                {
                    <MudText>Loading sets...</MudText>
                    { _ = LoadSetBricksAsync(brickContext.Item); }
                }
                else if (brickContext.Item.SetBricks.Any())
                {
                    <MudCard>
                        <MudDataGrid T="ApiClient.SetBrickDto" Items="brickContext.Item.SetBricks.OrderBy(s => s.SetId)">
                            <Columns>
                                <PropertyColumn Title="Set Id" Property="x => x.SetId"/>
                                <TemplateColumn Title="Needed per Copy">
                                    <CellTemplate>
                                        <MudText>@context.Item.Count</MudText>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="BoM">
                                    <CellTemplate>
                                        <MudIconButton href="@($"/bom/{context.Item.SetId}")"
                                                       Icon="@Icons.Material.Filled.List"
                                                       Variant="Variant.Filled" Color="Color.Primary"
                                                       Size="Size.Small"/>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </MudCard>
                }
                </div>
            </ChildRowContent>

            <NoRecordsContent>
                @if (_query.Trim().Length >= 2)
                {
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
                        <MudText Typo="Typo.h6">No bricks match “@_query”</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width: 480px;">
                            Double-check the spelling, or try the part number (e.g. <em>3001</em>) or a color name.
                        </MudText>
                    </MudStack>
                }
                else
                {
                    <MudText Class="pa-6" Align="Align.Center" Color="Color.Secondary">No bricks found.</MudText>
                }
            </NoRecordsContent>

            <PagerContent>
                <MudDataGridPager T="BrickInfo"/>
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private MudDataGrid<BrickInfo> _grid = null!;
    private string _query = "";
    private int _totalBricks;
    private long _totalOwnedStock;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var stats = await Api.GetBrickCatalogStatsAsync();
        if (stats != null)
        {
            _totalBricks = stats.TotalBricks;
            _totalOwnedStock = stats.TotalOwnedStock;
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task<GridData<BrickInfo>> LoadServerData(GridState<BrickInfo> state)
    {
        var page = await Api.GetBricksCatalogPageAsync(_query.Trim(), state.Page, state.PageSize);
        var rows = (page?.Items ?? []).Select(b => new BrickInfo { Brick = b }).ToList();
        return new GridData<BrickInfo> { Items = rows, TotalItems = page?.Total ?? 0 };
    }

    private async Task OnQueryChanged(string value)
    {
        _query = value ?? "";
        if (_grid is not null) await _grid.ReloadServerData();
    }

    private async Task LoadSetBricksAsync(BrickInfo info)
    {
        if (info.IsLoaded) return;
        var result = await Api.GetSetsForBrickAsync(info.Brick.PartNum, info.Brick.ColorId ?? "");
        info.SetBricks = result?.ToList() ?? [];
        info.IsLoaded = true;
        StateHasChanged();
    }

    private Task OpenImagePopup(string id, string name, string? imgUrl) =>
        DialogService.ShowAsync<ImagePopup>("Image Popup",
            new DialogParameters<ImagePopup>
            {
                { x => x._id, id }, { x => x._name, name }, { x => x._imgUrl, imgUrl }
            },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private Task OpenColorPopup(string hex, string name) =>
        DialogService.ShowAsync<ColorPopup>("Color Popup",
            new DialogParameters<ColorPopup>
            {
                { x => x._hexColor, hex }, { x => x._name, name }
            },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private class BrickInfo
    {
        public ApiClient.BrickCatalogViewDto Brick { get; set; } = null!;
        public bool IsLoaded { get; set; }
        public List<ApiClient.SetBrickDto> SetBricks { get; set; } = [];
    }
}
