@page "/minifigs"
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Components.Objects
@using Klods.Services
@using Microsoft.AspNetCore.Components.Routing
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Minifigs</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">Minifigs</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalMinifigs.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Minifigs in Catalog</MudText>
        </MudStack></MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalParts.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Total Parts</MudText>
        </MudStack></MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudTextField T="string" Value="_query" ValueChanged="OnSearch" Immediate="true" DebounceInterval="350"
                      Placeholder="Search by minifig name or number — or just browse below…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Clearable="true"/>
    </MudItem>

    <MudItem xs="12">
        @if (_loadingResults)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-8"><MudProgressCircular Indeterminate="true"/></MudStack>
        }
        else if (_rows.Count == 0)
        {
            <MudPaper Class="pa-8" Elevation="0">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
                    <MudText Typo="Typo.h6">No minifigs match your search</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width: 480px;">
                        Try a different spelling or the fig number (e.g. <em>sw0001</em>).
                    </MudText>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudDataGrid T="MinifigInfo" Items="_rows" SortMode="SortMode.None" ReadOnly="true">
                <Columns>
                    <HierarchyColumn T="MinifigInfo" ButtonDisabledFunc="@(info => info.Minifig.PartCount == 0)"/>
                    <TemplateColumn Title="Image" Editable="false">
                        <CellTemplate>
                            <MudStack Row>
                                <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                          Src="@ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl)" Height="50"
                                          @onclick="() => OpenImagePopup(context.Item.Minifig.MinifigId, context.Item.Minifig.MinifigName, ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl))"/>
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("id")'>Id@(Arrow("id"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.MinifigId</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("name")'>Name@(Arrow("name"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.MinifigName</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("parts")'>Parts@(Arrow("parts"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.PartCount</CellTemplate>
                    </TemplateColumn>
                </Columns>

                <ChildRowContent Context="minifigContext">
                    <div class="child-row-content">
                    @if (!minifigContext.Item.IsLoaded)
                    {
                        <MudCard><MudCardContent><MudText>Loading parts...</MudText></MudCardContent></MudCard>
                        { _ = LoadMinifigBricksAsync(minifigContext.Item); }
                    }
                    else if (minifigContext.Item.Bricks.Any())
                    {
                        <MudCard>
                            <MudDataGrid T="BrickEntry" Items="minifigContext.Item.Bricks.OrderBy(b => b.BrickId)">
                                <Columns>
                                    <TemplateColumn Title="Image" Editable="false">
                                        <CellTemplate>
                                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                                                <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                                          Src="@ImageStorage.ResolveUrl(context.Item.PartImg)" Height="50"
                                                          @onclick="() => OpenImagePopup(context.Item.BrickId, context.Item.Name, ImageStorage.ResolveUrl(context.Item.PartImg))"/>
                                            </MudStack>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Title="Part Id" Property="x => x.BrickId"/>
                                    <PropertyColumn Title="Name" Property="x => x.Name"/>
                                    <TemplateColumn Title="Color" Editable="false">
                                        <CellTemplate>
                                            <MudStack Row>
                                                @if (context.Item.HexColor != null)
                                                {
                                                    <MudChip T="string"
                                                        OnClick="() => OpenColorPopup(context.Item.HexColor, context.Item.ColorName)"
                                                        class="mud-elevation-2" Style="@ColorHelper.ColorChipStyle(context.Item.HexColor)">
                                                        @context.Item.ColorName
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Color="Color.Default">N/A</MudChip>
                                                }
                                            </MudStack>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Title="Quantity" Property="x => x.Quantity"/>
                                </Columns>
                            </MudDataGrid>
                        </MudCard>
                    }
                    </div>
                </ChildRowContent>
            </MudDataGrid>

            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mt-4">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Rows per page:</MudText>
                    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 88px;">
                        <MudSelectItem Value="25">25</MudSelectItem>
                        <MudSelectItem Value="50">50</MudSelectItem>
                        <MudSelectItem Value="100">100</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@RangeText</MudText>
                </MudStack>
                @if (_totalPages > 1)
                {
                    <MudPagination Color="Color.Primary" Count="_totalPages" Selected="_page" SelectedChanged="OnPageChanged"/>
                }
            </MudStack>
        }
    </MudItem>
</MudGrid>

<style> .sort-head { cursor: pointer; user-select: none; font-weight: 600; } </style>

@code {
    private List<MinifigInfo> _rows = [];
    private string _query = "";
    private string _sort = "parts";
    private string _dir = "desc";
    private int _page = 1;
    private int _pageSize = 25;
    private int _total;
    private int _totalPages = 1;
    private int _totalMinifigs;
    private long _totalParts;
    private bool _isLoading = true;
    private bool _loadingResults;

    private string RangeText
    {
        get
        {
            if (_total == 0) return "0 of 0";
            var from = (_page - 1) * _pageSize + 1;
            var to = Math.Min(_page * _pageSize, _total);
            return $"{from:N0}–{to:N0} of {_total:N0}";
        }
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnInitializedAsync()
    {
        var stats = await Api.GetMinifigCatalogStatsAsync();
        if (stats != null) { _totalMinifigs = stats.TotalMinifigs; _totalParts = stats.TotalParts; }
        ParseUrl();
        await LoadAsync();
        _isLoading = false;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(async () => { ParseUrl(); await LoadAsync(); });

    private void ParseUrl()
    {
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        _query = qs["q"] ?? "";
        _sort = qs["sort"] ?? "parts";
        _dir = qs["dir"] ?? "desc";
        _page = int.TryParse(qs["page"], out var p) && p > 0 ? p : 1;
        _pageSize = int.TryParse(qs["size"], out var sz) && sz is 25 or 50 or 100 ? sz : 25;
    }

    private async Task LoadAsync()
    {
        _loadingResults = true;
        StateHasChanged();
        var page = await Api.GetMinifigsCatalogPageAsync(_query.Trim(), _sort, _dir, _page - 1, _pageSize);
        _rows = (page?.Items ?? []).Select(m => new MinifigInfo { Minifig = m }).ToList();
        _total = page?.Total ?? 0;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
        _loadingResults = false;
        StateHasChanged();
    }

    private void Navigate()
    {
        var parts = new List<string>();
        var q = _query.Trim();
        if (q.Length > 0) parts.Add($"q={Uri.EscapeDataString(q)}");
        if (_sort != "parts") parts.Add($"sort={_sort}");
        if (_dir != "desc") parts.Add($"dir={_dir}");
        if (_pageSize != 25) parts.Add($"size={_pageSize}");
        if (_page > 1) parts.Add($"page={_page}");
        Nav.NavigateTo("/minifigs" + (parts.Count > 0 ? "?" + string.Join("&", parts) : ""));
    }

    private void OnSearch(string value) { _query = value ?? ""; _page = 1; Navigate(); }
    private void OnPageChanged(int page) { _page = page; Navigate(); }
    private void OnPageSizeChanged(int size) { _pageSize = size; _page = 1; Navigate(); }

    private void SetSort(string field)
    {
        if (_sort == field) _dir = _dir == "asc" ? "desc" : "asc";
        else { _sort = field; _dir = field == "parts" ? "desc" : "asc"; }
        _page = 1;
        Navigate();
    }

    private string Arrow(string field) => field == _sort ? (_dir == "asc" ? " ▲" : " ▼") : "";

    private async Task LoadMinifigBricksAsync(MinifigInfo info)
    {
        if (info.IsLoaded) return;
        var bricks = await Api.GetMinifigBricksAsync(info.Minifig.MinifigId);
        info.Bricks = bricks?.Select(b => new BrickEntry
        {
            BrickId = b.BrickId, ColorId = b.ColorId, Name = b.Name, PartImg = b.PartImg,
            ColorName = b.ColorName, HexColor = b.HexColor, Quantity = b.Quantity
        }).ToList() ?? [];
        info.IsLoaded = true;
        StateHasChanged();
    }

    private Task OpenImagePopup(string id, string name, string? imgUrl) =>
        DialogService.ShowAsync<ImagePopup>("Image Popup",
            new DialogParameters<ImagePopup> { { x => x._id, id }, { x => x._name, name }, { x => x._imgUrl, imgUrl } },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private Task OpenColorPopup(string hex, string name) =>
        DialogService.ShowAsync<ColorPopup>("Color Popup",
            new DialogParameters<ColorPopup> { { x => x._hexColor, hex }, { x => x._name, name } },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private class MinifigInfo
    {
        public ApiClient.MinifigCatalogViewDto Minifig { get; set; } = null!;
        public List<BrickEntry> Bricks { get; set; } = [];
        public bool IsLoaded { get; set; }
    }

    private class BrickEntry
    {
        public string BrickId { get; set; } = "";
        public string ColorId { get; set; } = "";
        public string Name { get; set; } = "";
        public string? PartImg { get; set; }
        public string? ColorName { get; set; }
        public string? HexColor { get; set; }
        public int Quantity { get; set; }
    }
}
