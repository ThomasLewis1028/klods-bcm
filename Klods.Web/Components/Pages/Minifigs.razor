@page "/minifigs"
@inject ILoggerFactory LoggerFactory
@inject IDialogService DialogService
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Components.Objects
@using Klods.Services
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@rendermode InteractiveServer

<PageTitle>Minifigs</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">Minifigs</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    @* Stats *@
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalMinifigs.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Minifigs in Catalog</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalParts.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Parts</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* Search *@
    <MudItem xs="12">
        <MudTextField T="string" Value="_query" ValueChanged="OnQueryChanged"
                      Immediate="true" DebounceInterval="350"
                      Placeholder="Search by minifig name or number — or just browse below…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Clearable="true"/>
    </MudItem>

    @* Catalog (server-paginated; most parts by default) *@
    <MudItem xs="12">
        <MudDataGrid T="MinifigInfo" @ref="_grid" ServerData="LoadServerData"
                     SortMode="SortMode.None" ReadOnly="true">
            <Columns>
                <HierarchyColumn T="MinifigInfo" ButtonDisabledFunc="@(info => info.Minifig.PartCount == 0)"/>
                <TemplateColumn Title="Image" Editable="false">
                    <CellTemplate>
                        <MudStack Row>
                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                      Src="@ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl)" Height="50"
                                      @onclick="() => OpenImagePopup(context.Item.Minifig.MinifigId, context.Item.Minifig.MinifigName, ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl))"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Minifig.MinifigId" Title="Id" Editable="false"/>
                <PropertyColumn Property="x => x.Minifig.MinifigName" Title="Name" Editable="false"/>
                <PropertyColumn Property="x => x.Minifig.PartCount" Title="Parts" Editable="false"/>
            </Columns>

            <ChildRowContent Context="minifigContext">
                <div class="child-row-content">
                @if (!minifigContext.Item.IsLoaded)
                {
                    <MudCard>
                        <MudCardContent>
                            <MudText>Loading parts...</MudText>
                        </MudCardContent>
                    </MudCard>
                    {
                        _ = LoadMinifigBricksAsync(minifigContext.Item);
                    }
                }
                else if (minifigContext.Item.Bricks.Any())
                {
                    <MudCard>
                        <MudDataGrid T="BrickEntry" Items="minifigContext.Item.Bricks.OrderBy(b => b.BrickId)">
                            <Columns>
                                <TemplateColumn Title="Image" Editable="false">
                                    <CellTemplate>
                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                                      Src="@ImageStorage.ResolveUrl(context.Item.PartImg)" Height="50"
                                                      @onclick="() => OpenImagePopup(context.Item.BrickId, context.Item.Name, ImageStorage.ResolveUrl(context.Item.PartImg))"/>
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Title="Part Id" Property="x => x.BrickId"/>
                                <PropertyColumn Title="Name" Property="x => x.Name"/>
                                <TemplateColumn Title="Color" Editable="false">
                                    <CellTemplate>
                                        <MudStack Row>
                                            @if (context.Item.HexColor != null)
                                            {
                                                <MudChip T="string"
                                                    OnClick="() => OpenColorPopup(context.Item.HexColor, context.Item.ColorName)"
                                                    class="mud-elevation-2"
                                                    Style="@ColorHelper.ColorChipStyle(context.Item.HexColor)">
                                                    @context.Item.ColorName
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Default">N/A</MudChip>
                                            }
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Title="Quantity" Property="x => x.Quantity"/>
                            </Columns>
                        </MudDataGrid>
                    </MudCard>
                }
                </div>
            </ChildRowContent>

            <NoRecordsContent>
                @if (_query.Trim().Length >= 2)
                {
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
                        <MudText Typo="Typo.h6">No minifigs match “@_query”</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width: 480px;">
                            Double-check the spelling or try the fig number (e.g. <em>sw0001</em>).
                        </MudText>
                    </MudStack>
                }
                else
                {
                    <MudText Class="pa-6" Align="Align.Center" Color="Color.Secondary">No minifigs found.</MudText>
                }
            </NoRecordsContent>

            <PagerContent>
                <MudDataGridPager T="MinifigInfo"/>
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private MudDataGrid<MinifigInfo> _grid = null!;
    private string _query = "";
    private int _totalMinifigs;
    private long _totalParts;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var stats = await Api.GetMinifigCatalogStatsAsync();
        if (stats != null)
        {
            _totalMinifigs = stats.TotalMinifigs;
            _totalParts = stats.TotalParts;
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task<GridData<MinifigInfo>> LoadServerData(GridState<MinifigInfo> state)
    {
        var page = await Api.GetMinifigsCatalogPageAsync(_query.Trim(), state.Page, state.PageSize);
        var rows = (page?.Items ?? []).Select(m => new MinifigInfo { Minifig = m }).ToList();
        return new GridData<MinifigInfo> { Items = rows, TotalItems = page?.Total ?? 0 };
    }

    private async Task OnQueryChanged(string value)
    {
        _query = value ?? "";
        if (_grid is not null) await _grid.ReloadServerData();
    }

    private async Task LoadMinifigBricksAsync(MinifigInfo minifigInfo)
    {
        if (minifigInfo.IsLoaded) return;
        var bricks = await Api.GetMinifigBricksAsync(minifigInfo.Minifig.MinifigId);
        minifigInfo.Bricks = bricks?.Select(b => new BrickEntry
        {
            BrickId = b.BrickId,
            ColorId = b.ColorId,
            Name = b.Name,
            PartImg = b.PartImg,
            ColorName = b.ColorName,
            HexColor = b.HexColor,
            Quantity = b.Quantity
        }).ToList() ?? [];
        minifigInfo.IsLoaded = true;
        StateHasChanged();
    }

    private Task OpenImagePopup(string id, string name, string? imgUrl)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true };
        var parameters = new DialogParameters<ImagePopup>
        {
            { x => x._id, id },
            { x => x._name, name },
            { x => x._imgUrl, imgUrl }
        };
        return DialogService.ShowAsync<ImagePopup>("Image Popup", parameters, options);
    }

    private Task OpenColorPopup(string hex, string name)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true };
        var parameters = new DialogParameters<ColorPopup>
        {
            { x => x._hexColor, hex },
            { x => x._name, name },
        };
        return DialogService.ShowAsync<ColorPopup>("Color Popup", parameters, options);
    }

    private class MinifigInfo
    {
        public ApiClient.MinifigCatalogViewDto Minifig { get; set; } = null!;
        public List<BrickEntry> Bricks { get; set; } = [];
        public bool IsLoaded { get; set; }
    }

    private class BrickEntry
    {
        public string BrickId { get; set; } = "";
        public string ColorId { get; set; } = "";
        public string Name { get; set; } = "";
        public string? PartImg { get; set; }
        public string? ColorName { get; set; }
        public string? HexColor { get; set; }
        public int Quantity { get; set; }
    }
}
