@page "/minifigs"
@inject ILoggerFactory LoggerFactory
@inject IDialogService DialogService
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using System.Drawing
@using Klods.Components.Objects
@using Klods.Services
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@rendermode InteractiveServer

<PageTitle>@_pageTitle</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">Minifigs</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    <MudItem xs="12">
        <MudDataGrid T="MinifigInfo" Items="@_minifigInfos.OrderBy(m => m.Minifig.MinifigId)"
                     SortMode="@SortMode.Multiple" EditMode="DataGridEditMode.Cell"
                     QuickFilter="MinifigFilterFunc"
                     ReadOnly="false">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Total Minifigs: @_minifigInfos.Count</MudText>
                <MudSpacer/>
                <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start"
                              Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                              Class="mt-0"/>
            </ToolBarContent>
            <Columns>
                <HierarchyColumn T="MinifigInfo" ButtonDisabledFunc="@(info => info.Minifig.PartCount == 0)"/>
                <TemplateColumn Title="Image" Editable="false">
                    <CellTemplate>
                        <MudStack Row>
                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                      Src="@ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl)" Height="50"
                                      @onclick="() => OpenImagePopup(context.Item.Minifig.MinifigId, context.Item.Minifig.MinifigName, ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl))"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Minifig.MinifigId" Title="Id" Editable="false"/>
                <PropertyColumn Property="x => x.Minifig.MinifigName" Title="Name" Editable="false"/>
                <PropertyColumn Property="x => x.Minifig.PartCount" Title="Parts" Editable="false"/>
            </Columns>

            <ChildRowContent Context="minifigContext">
                <div class="child-row-content">
                @if (!minifigContext.Item.IsLoaded)
                {
                    <MudCard>
                        <MudCardContent>
                            <MudText>Loading parts...</MudText>
                        </MudCardContent>
                    </MudCard>
                    {
                        _ = LoadMinifigBricksAsync(minifigContext.Item);
                    }
                }
                else if (minifigContext.Item.Bricks.Any())
                {
                    <MudCard>
                        <MudDataGrid T="BrickEntry" Items="minifigContext.Item.Bricks.OrderBy(b => b.BrickId)">
                            <Columns>
                                <TemplateColumn Title="Image" Editable="false">
                                    <CellTemplate>
                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                                      Src="@ImageStorage.ResolveUrl(context.Item.PartImg)" Height="50"
                                                      @onclick="() => OpenImagePopup(context.Item.BrickId, context.Item.Name, ImageStorage.ResolveUrl(context.Item.PartImg))"/>
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Title="Part Id" Property="x => x.BrickId"/>
                                <PropertyColumn Title="Name" Property="x => x.Name"/>
                                <TemplateColumn Title="Color" SortBy="x => x.ColorId" Sortable="true" Editable="false">
                                    <CellTemplate>
                                        <MudStack Row>
                                            @if (context.Item.HexColor != null)
                                            {
                                                @if (ColorHelper.IsDark(context.Item.HexColor))
                                                {
                                                    <MudChip T="string"
                                                        OnClick="() => OpenColorPopup(context.Item.HexColor, context.Item.ColorName)"
                                                        class="mud-elevation-2"
                                                        Style="@($"background-color: {"#" + context.Item.HexColor}; color: white; width: -moz-available;")">@context.Item.ColorName</MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string"
                                                        OnClick="() => OpenColorPopup(context.Item.HexColor, context.Item.ColorName)"
                                                        class="mud-elevation-2"
                                                        Style="@($"background-color: {"#" + context.Item.HexColor}; color: #202020; width: -moz-available;")">@context.Item.ColorName</MudChip>
                                                }
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Default">N/A</MudChip>
                                            }
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Title="Quantity" Property="x => x.Quantity"/>
                            </Columns>
                        </MudDataGrid>
                    </MudCard>
                }
                </div>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="MinifigInfo"/>
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private string _pageTitle = "Minifigs";
    private List<MinifigInfo> _minifigInfos = [];
    private string searchString = "";
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var logger = LoggerFactory.CreateLogger<Minifigs>();
        logger.LogTrace("Loading Minifigs");
        var minifigs = await Api.GetMinifigsCatalogViewAsync();
        _minifigInfos = minifigs?.Select(m => new MinifigInfo { Minifig = m }).ToList() ?? [];
        _isLoading = false;
        StateHasChanged();
        logger.LogTrace("Loading Minifigs Complete");
    }

    private async Task LoadMinifigBricksAsync(MinifigInfo minifigInfo)
    {
        if (minifigInfo.IsLoaded) return;
        var bricks = await Api.GetMinifigBricksAsync(minifigInfo.Minifig.MinifigId);
        minifigInfo.Bricks = bricks?.Select(b => new BrickEntry
        {
            BrickId = b.BrickId,
            ColorId = b.ColorId,
            Name = b.Name,
            PartImg = b.PartImg,
            ColorName = b.ColorName,
            HexColor = b.HexColor,
            Quantity = b.Quantity
        }).ToList() ?? [];
        minifigInfo.IsLoaded = true;
        StateHasChanged();
    }

    private bool MinifigFilterFunc(MinifigInfo info) => MinifigFilter(info);

    private bool MinifigFilter(MinifigInfo info)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (info.Minifig.MinifigId.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (info.Minifig.MinifigName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private Task OpenImagePopup(string id, string name, string? imgUrl)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true };
        var parameters = new DialogParameters<ImagePopup>
        {
            { x => x._id, id },
            { x => x._name, name },
            { x => x._imgUrl, imgUrl }
        };
        return DialogService.ShowAsync<ImagePopup>("Image Popup", parameters, options);
    }

    private Task OpenColorPopup(string hex, string name)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true };
        var parameters = new DialogParameters<ColorPopup>
        {
            { x => x._hexColor, hex },
            { x => x._name, name },
        };
        return DialogService.ShowAsync<ColorPopup>("Color Popup", parameters, options);
    }

    private class MinifigInfo
    {
        public ApiClient.MinifigCatalogViewDto Minifig { get; set; } = null!;
        public List<BrickEntry> Bricks { get; set; } = [];
        public bool IsLoaded { get; set; }
    }

    private class BrickEntry
    {
        public string BrickId { get; set; } = "";
        public string ColorId { get; set; } = "";
        public string Name { get; set; } = "";
        public string? PartImg { get; set; }
        public string? ColorName { get; set; }
        public string? HexColor { get; set; }
        public int Quantity { get; set; }
    }
}
