@page "/my/minifigs"
@inject IDialogService DialogService
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Components.Objects
@using Klods.Services
@using Microsoft.AspNetCore.Components.Routing
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable

<PageTitle>My Minifigs</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">My Minifigs</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    @* Stats *@
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@TotalMinifigs.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Unique Minifigs</MudText>
        </MudStack></MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@TotalOwned.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Owned</MudText>
        </MudStack></MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@TotalNeeded.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Still Needed</MudText>
        </MudStack></MudPaper>
    </MudItem>

    @* Search *@
    <MudItem xs="12">
        <MudTextField T="string" Value="_query" ValueChanged="OnSearch" Immediate="true" DebounceInterval="350"
                      Placeholder="Search by minifig name or ID…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Clearable="true"/>
    </MudItem>

    <MudItem xs="12">
        @* Toolbar: Import + view toggle *@
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="OpenImportMinifigDialog">
                Import
            </MudButton>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                @if (_view == "grid")
                {
                    <MudMenu Label="@SortLabel" StartIcon="@Icons.Material.Filled.Sort"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Outlined" Size="Size.Small">
                        @foreach (var (field, label) in _sortOptions)
                        {
                            <MudMenuItem OnClick="@(() => SetSort(field))">@label@(Arrow(field))</MudMenuItem>
                        }
                    </MudMenu>
                }
                <MudToggleGroup T="string" Value="_view" ValueChanged="OnViewChanged" Size="Size.Small"
                                Color="Color.Primary" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Dense="true">
                    <MudToggleItem Value="@("list")"><MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small"/></MudToggleItem>
                    <MudToggleItem Value="@("grid")"><MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small"/></MudToggleItem>
                </MudToggleGroup>
            </MudStack>
        </MudStack>

        @if (_minifigInfos.Count == 0)
        {
            <MudPaper Class="pa-8" Elevation="0">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Secondary"/>
                    <MudText Typo="Typo.h6">No minifigs in your collection yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width: 480px;">
                        Add a set containing minifigs, or import them directly.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download" OnClick="OpenImportMinifigDialog">
                        Import Minifig
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (TotalFiltered == 0)
        {
            <MudPaper Class="pa-8" Elevation="0">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
                    <MudText Typo="Typo.h6">No minifigs match your search</MudText>
                    <MudButton Variant="Variant.Text" OnClick="@(() => { _query = ""; _page = 1; Navigate(); })">Clear search</MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (_view == "grid")
        {
            <div class="card-grid">
                @foreach (var info in PagedItems)
                {
                    var r = info;
                    <MudPaper Class="catalog-card" Elevation="2" @onclick="() => OpenMinifigDialog(r)">
                        <div class="card-img">
                            <MudImage Src="@ImageStorage.ResolveUrl(r.Minifig.ImgUrl)"
                                      Style="max-width:100%; max-height:100%; object-fit:contain;"/>
                        </div>
                        <div class="card-label">
                            <MudText Typo="Typo.body2" Style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@r.Minifig.MinifigName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @r.Minifig.MinifigId · ×@(r.Stock + r.Minifig.InUseStock)
                            </MudText>
                        </div>
                    </MudPaper>
                }
            </div>
        }
        else
        {
            <MudDataGrid T="MyMinifigInfo" Items="@PagedItems.ToList()" SortMode="SortMode.None" ReadOnly="false">
                <Columns>
                    <HierarchyColumn T="MyMinifigInfo" ButtonDisabledFunc="@(info => info.Minifig.PartCount == 0)"/>
                    <TemplateColumn Title="Image" Editable="false">
                        <CellTemplate>
                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                      Src="@ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl)" Height="50"
                                      @onclick="() => OpenImagePopup(context.Item.Minifig.MinifigId, context.Item.Minifig.MinifigName, ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl))"/>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("id")'>Id@(Arrow("id"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.MinifigId</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("name")'>Name@(Arrow("name"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.MinifigName</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("loose")'>Loose@(Arrow("loose"))</span></HeaderTemplate>
                        <CellTemplate>
                            <MudNumericField T="int" Value="@context.Item.Stock"
                                             ValueChanged="@(v => SaveMinifigOwnedStock(context.Item, v))"
                                             Min="0" Disabled="@(AuthService.CurrentUser == null)"
                                             Variant="Variant.Text"/>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("inuse")'>In Use@(Arrow("inuse"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.InUseStock</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("needed")'>Needed@(Arrow("needed"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.UserNeeded</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("sets")'>Sets@(Arrow("sets"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.UserSetCount</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("parts")'>Parts@(Arrow("parts"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Minifig.PartCount</CellTemplate>
                    </TemplateColumn>
                </Columns>

                <ChildRowContent Context="minifigContext">
                    <div class="child-row-content">
                    @if (!minifigContext.Item.IsLoaded)
                    {
                        <MudCard><MudCardContent><MudText>Loading parts…</MudText></MudCardContent></MudCard>
                        { _ = LoadMinifigBricksAsync(minifigContext.Item); }
                    }
                    else if (minifigContext.Item.Bricks.Any())
                    {
                        <MudCard>
                            <MudDataGrid T="BrickEntry" Items="minifigContext.Item.Bricks.OrderBy(b => b.BrickId)">
                                <Columns>
                                    <TemplateColumn Title="Image" Editable="false">
                                        <CellTemplate>
                                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                                                <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                                          Src="@ImageStorage.ResolveUrl(context.Item.PartImg)" Height="50"
                                                          @onclick="() => OpenImagePopup(context.Item.BrickId, context.Item.Name, ImageStorage.ResolveUrl(context.Item.PartImg))"/>
                                            </MudStack>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Title="Part Id" Property="x => x.BrickId"/>
                                    <PropertyColumn Title="Name" Property="x => x.Name"/>
                                    <TemplateColumn Title="Color" SortBy="x => x.ColorId" Sortable="true" Editable="false">
                                        <CellTemplate>
                                            @if (context.Item.HexColor != null)
                                            {
                                                <MudChip T="string"
                                                    OnClick="() => OpenColorPopup(context.Item.HexColor, context.Item.ColorName)"
                                                    class="mud-elevation-2"
                                                    Style="@ColorHelper.ColorChipStyle(context.Item.HexColor)">
                                                    @context.Item.ColorName
                                                </MudChip>
                                            }
                                            else { <MudChip T="string" Color="Color.Default">N/A</MudChip> }
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Title="Need" Property="x => x.Need" Editable="false"/>
                                    <TemplateColumn Title="Owned">
                                        <CellTemplate>
                                            <MudNumericField T="int" Value="@context.Item.Owned"
                                                             ValueChanged="@(v => SaveLooseBrickStock(minifigContext.Item, context.Item, v))"
                                                             Min="0" Disabled="@(AuthService.CurrentUser == null)"
                                                             Variant="Variant.Text"/>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        </MudCard>
                    }
                    </div>
                </ChildRowContent>
            </MudDataGrid>
        }

        @if (_minifigInfos.Count > 0 && TotalFiltered > 0)
        {
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mt-4">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Rows per page:</MudText>
                    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 88px;">
                        <MudSelectItem Value="25">25</MudSelectItem>
                        <MudSelectItem Value="50">50</MudSelectItem>
                        <MudSelectItem Value="100">100</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@RangeText</MudText>
                </MudStack>
                @if (TotalPages > 1)
                {
                    <MudPagination Color="Color.Primary" Count="TotalPages" Selected="_page" SelectedChanged="OnPageChanged"/>
                }
            </MudStack>
        }
    </MudItem>
</MudGrid>

<style>
    .sort-head { cursor: pointer; user-select: none; font-weight: 600; }
    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; }
    .catalog-card { border-radius: 16px; overflow: hidden; cursor: pointer; display: flex; flex-direction: column;
                    transition: transform .12s ease, box-shadow .12s ease; }
    .catalog-card:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,0.25); }
    .card-img { aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; padding: 14px;
                background: var(--mud-palette-surface); }
    .card-label { padding: 8px 12px; }
</style>

@code {
    private List<MyMinifigInfo> _minifigInfos = [];
    private bool _isLoading = true;

    private string _query = "";
    private string _sort = "name";
    private string _dir = "asc";
    private int _page = 1;
    private int _pageSize = 25;
    private string _view = "list";

    private static readonly (string Field, string Label)[] _sortOptions =
    [
        ("name", "Name"), ("id", "Minifig ID"), ("loose", "Loose"),
        ("inuse", "In Use"), ("needed", "Needed"), ("sets", "Sets"), ("parts", "Parts"),
    ];
    private string SortLabel => "Sort: " + (_sortOptions.FirstOrDefault(o => o.Field == _sort).Label ?? "Name");

    // ── Stats ──────────────────────────────────────────────────────────────────
    private int TotalMinifigs => _minifigInfos.Count;
    private int TotalOwned => _minifigInfos.Sum(m => m.Stock + m.Minifig.InUseStock);
    private int TotalNeeded => _minifigInfos.Sum(m => m.Minifig.UserNeeded);

    // ── Filter / sort / page pipeline ─────────────────────────────────────────
    private IEnumerable<MyMinifigInfo> FilteredItems => _minifigInfos.Where(m =>
        string.IsNullOrWhiteSpace(_query) ||
        m.Minifig.MinifigId.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
        m.Minifig.MinifigName.Contains(_query, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MyMinifigInfo> SortedItems
    {
        get
        {
            var asc = _dir == "asc";
            return _sort switch
            {
                "id"     => asc ? FilteredItems.OrderBy(m => m.Minifig.MinifigId)     : FilteredItems.OrderByDescending(m => m.Minifig.MinifigId),
                "loose"  => asc ? FilteredItems.OrderBy(m => m.Stock)                 : FilteredItems.OrderByDescending(m => m.Stock),
                "inuse"  => asc ? FilteredItems.OrderBy(m => m.Minifig.InUseStock)    : FilteredItems.OrderByDescending(m => m.Minifig.InUseStock),
                "needed" => asc ? FilteredItems.OrderBy(m => m.Minifig.UserNeeded)    : FilteredItems.OrderByDescending(m => m.Minifig.UserNeeded),
                "sets"   => asc ? FilteredItems.OrderBy(m => m.Minifig.UserSetCount)  : FilteredItems.OrderByDescending(m => m.Minifig.UserSetCount),
                "parts"  => asc ? FilteredItems.OrderBy(m => m.Minifig.PartCount)     : FilteredItems.OrderByDescending(m => m.Minifig.PartCount),
                _        => asc ? FilteredItems.OrderBy(m => m.Minifig.MinifigName)   : FilteredItems.OrderByDescending(m => m.Minifig.MinifigName),
            };
        }
    }

    private IEnumerable<MyMinifigInfo> PagedItems => SortedItems.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalFiltered => FilteredItems.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalFiltered / (double)_pageSize));

    private string RangeText
    {
        get
        {
            if (TotalFiltered == 0) return "0 of 0";
            var from = (_page - 1) * _pageSize + 1;
            var to = Math.Min(_page * _pageSize, TotalFiltered);
            return $"{from:N0}–{to:N0} of {TotalFiltered:N0}";
        }
    }

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        AuthService.SessionRestored += OnSessionRestored;
    }

    protected override async Task OnInitializedAsync()
    {
        ParseUrl();
        await LoadDataAsync();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        AuthService.SessionRestored -= OnSessionRestored;
    }

    private void OnSessionRestored() => InvokeAsync(async () =>
    {
        if (AuthService.CurrentUser == null) { Nav.NavigateTo("/not-authorized"); return; }
        ParseUrl();
        await LoadDataAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(() => { ParseUrl(); StateHasChanged(); });

    // ── URL state ─────────────────────────────────────────────────────────────
    private void ParseUrl()
    {
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        _query = qs["q"] ?? "";
        _sort = qs["sort"] ?? "name";
        _dir = qs["dir"] ?? "asc";
        _page = int.TryParse(qs["page"], out var p) && p > 0 ? p : 1;
        _pageSize = int.TryParse(qs["size"], out var sz) && sz is 25 or 50 or 100 ? sz : 25;
        _view = qs["view"] == "grid" ? "grid" : "list";
    }

    private void Navigate()
    {
        var parts = new List<string>();
        var q = _query.Trim();
        if (q.Length > 0) parts.Add($"q={Uri.EscapeDataString(q)}");
        if (_sort != "name") parts.Add($"sort={_sort}");
        if (_dir != "asc") parts.Add($"dir={_dir}");
        if (_pageSize != 25) parts.Add($"size={_pageSize}");
        if (_view != "list") parts.Add($"view={_view}");
        if (_page > 1) parts.Add($"page={_page}");
        Nav.NavigateTo("/my/minifigs" + (parts.Count > 0 ? "?" + string.Join("&", parts) : ""));
    }

    // ── Data ──────────────────────────────────────────────────────────────────
    private async Task LoadDataAsync()
    {
        var minifigs = await Api.GetMyMinifigsAsync();
        _minifigInfos = minifigs?.Select(m => new MyMinifigInfo { Minifig = m, Stock = m.Stock }).ToList() ?? [];
        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadMinifigBricksAsync(MyMinifigInfo info)
    {
        if (info.IsLoaded) return;
        var bricks = await Api.GetMyMinifigLooseBricksAsync(info.Minifig.MinifigId);
        info.Bricks = bricks?.Select(b => new BrickEntry
        {
            BrickId = b.PartNum, ColorId = b.ColorId, Name = b.Name, PartImg = b.PartImg,
            ColorName = b.ColorName, HexColor = b.HexColor, Need = b.Need, Owned = b.Owned
        }).ToList() ?? [];
        info.IsLoaded = true;
        StateHasChanged();
    }

    // ── Handlers ──────────────────────────────────────────────────────────────
    private void OnSearch(string value) { _query = value ?? ""; _page = 1; Navigate(); }
    private void OnViewChanged(string view) { _view = view == "grid" ? "grid" : "list"; Navigate(); }
    private void OnPageChanged(int page) { _page = page; Navigate(); }
    private void OnPageSizeChanged(int size) { _pageSize = size; _page = 1; Navigate(); }

    private void SetSort(string field)
    {
        if (_sort == field)
            _dir = _dir == "asc" ? "desc" : "asc";
        else
        {
            _sort = field;
            _dir = field is "loose" or "inuse" or "needed" or "sets" or "parts" ? "desc" : "asc";
        }
        _page = 1;
        Navigate();
    }

    private string Arrow(string field) => field == _sort ? (_dir == "asc" ? " ▲" : " ▼") : "";

    private async Task SaveMinifigOwnedStock(MyMinifigInfo info, int newValue)
    {
        if (newValue < 0) return;
        info.Stock = newValue;
        await Api.UpsertMinifigStockAsync(info.Minifig.MinifigId, newValue);
        StateHasChanged();
    }

    private async Task SaveLooseBrickStock(MyMinifigInfo minifig, BrickEntry brick, int newValue)
    {
        if (newValue < 0) return;
        brick.Owned = newValue;
        await Api.UpdateMyMinifigLooseBrickStockAsync(minifig.Minifig.MinifigId, brick.BrickId, brick.ColorId, newValue);
        StateHasChanged();
    }

    private async Task OpenImportMinifigDialog()
    {
        var dialog = await DialogService.ShowAsync<ImportMinifigDialog>("Import Minifigs",
            new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadDataAsync();
    }

    private async Task OpenMinifigDialog(MyMinifigInfo info)
    {
        var dto = new ApiClient.MinifigCatalogViewDto(
            info.Minifig.MinifigId, info.Minifig.MinifigName, info.Minifig.ImgUrl, "", info.Minifig.PartCount);
        var parameters = new DialogParameters<MinifigDetailDialog> { { x => x.Minifig, dto } };
        await DialogService.ShowAsync<MinifigDetailDialog>(info.Minifig.MinifigName, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        await LoadDataAsync();
    }

    private Task OpenImagePopup(string id, string name, string? imgUrl) =>
        DialogService.ShowAsync<ImagePopup>("Image Popup",
            new DialogParameters<ImagePopup> { { x => x._id, id }, { x => x._name, name }, { x => x._imgUrl, imgUrl } },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private Task OpenColorPopup(string? hex, string? name)
    {
        if (hex == null || name == null) return Task.CompletedTask;
        return DialogService.ShowAsync<ColorPopup>("Color Popup",
            new DialogParameters<ColorPopup> { { x => x._hexColor, hex }, { x => x._name, name } },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
    }

    private class MyMinifigInfo
    {
        public ApiClient.MyMinifigDto Minifig { get; set; } = null!;
        public int Stock { get; set; }
        public bool IsLoaded { get; set; }
        public List<BrickEntry> Bricks { get; set; } = [];
    }

    private class BrickEntry
    {
        public string BrickId { get; set; } = "";
        public string ColorId { get; set; } = "";
        public string Name { get; set; } = "";
        public string? PartImg { get; set; }
        public string? ColorName { get; set; }
        public string? HexColor { get; set; }
        public int Need { get; set; }
        public int Owned { get; set; }
    }
}
