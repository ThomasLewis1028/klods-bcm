@page "/my/minifigs"
@inject IDialogService DialogService
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Components.Objects
@using Klods.Services
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable

<PageTitle>My Minifigs</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">My Minifigs</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    <MudItem xs="12">
        <MudDataGrid T="MyMinifigInfo" Items="@_minifigInfos.OrderBy(m => m.Minifig.MinifigId)"
                     SortMode="@SortMode.Multiple" EditMode="DataGridEditMode.Cell"
                     QuickFilter="MinifigFilterFunc"
                     ReadOnly="false">
            <ToolBarContent>
                <MudText Typo="Typo.h6">My Minifigs: @_minifigInfos.Count</MudText>
                <MudSpacer/>
                <MudText Typo="Typo.h6">In Stock: @_minifigInfos.Sum(m => m.Stock)</MudText>
                <MudSpacer/>
                <MudText Typo="Typo.h6">Needed: @_minifigInfos.Sum(m => m.Minifig.UserNeeded)</MudText>
                <MudSpacer/>
                <MudTextField @bind-Value="_search" Placeholder="Search" Adornment="Adornment.Start"
                              Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0"/>
                <MudTooltip Text="@(AuthService.CurrentUser == null ? "Sign in to import" : "Import a minifig")">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-2"
                               StartIcon="@(AuthService.CurrentUser == null ? Icons.Material.Filled.Lock : Icons.Material.Filled.Download)"
                               Disabled="@(AuthService.CurrentUser == null)"
                               OnClick="OpenImportMinifigDialog">
                        Import
                    </MudButton>
                </MudTooltip>
            </ToolBarContent>
            <Columns>
                <HierarchyColumn T="MyMinifigInfo" ButtonDisabledFunc="@(info => info.Minifig.PartCount == 0)"/>
                <TemplateColumn Title="Image" Editable="false">
                    <CellTemplate>
                        <MudStack Row>
                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                      Src="@ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl)" Height="50"
                                      @onclick="() => OpenImagePopup(context.Item.Minifig.MinifigId, context.Item.Minifig.MinifigName, ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl))"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Minifig.MinifigId" Title="Id" Editable="false"/>
                <PropertyColumn Property="x => x.Minifig.MinifigName" Title="Name" Editable="false"/>
                <TemplateColumn Title="My Stock" Editable="false" Sortable="true" SortBy="x => x.Stock">
                    <CellTemplate>
                        <MudNumericField T="int"
                                         Value="@context.Item.Stock"
                                         ValueChanged="@(v => SaveMinifigOwnedStock(context.Item, v))"
                                         Min="0"
                                         Variant="Variant.Text"/>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Minifig.UserNeeded" Title="Needed" Editable="false"/>
                <PropertyColumn Property="x => x.Minifig.UserSetCount" Title="Sets" Editable="false"/>
                <PropertyColumn Property="x => x.Minifig.PartCount" Title="Parts" Editable="false"/>
            </Columns>

            <ChildRowContent Context="minifigContext">
                <div class="child-row-content">
                @if (!minifigContext.Item.IsLoaded)
                {
                    <MudCard>
                        <MudCardContent>
                            <MudText>Loading parts...</MudText>
                        </MudCardContent>
                    </MudCard>
                    {
                        _ = LoadMinifigBricksAsync(minifigContext.Item);
                    }
                }
                else if (minifigContext.Item.Bricks.Any())
                {
                    <MudCard>
                        <MudDataGrid T="BrickEntry" Items="minifigContext.Item.Bricks.OrderBy(b => b.BrickId)">
                            <Columns>
                                <TemplateColumn Title="Image" Editable="false">
                                    <CellTemplate>
                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                                      Src="@ImageStorage.ResolveUrl(context.Item.PartImg)" Height="50"
                                                      @onclick="() => OpenImagePopup(context.Item.BrickId, context.Item.Name, ImageStorage.ResolveUrl(context.Item.PartImg))"/>
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Title="Part Id" Property="x => x.BrickId"/>
                                <PropertyColumn Title="Name" Property="x => x.Name"/>
                                <TemplateColumn Title="Color" SortBy="x => x.ColorId" Sortable="true" Editable="false">
                                    <CellTemplate>
                                        <MudStack Row>
                                            @if (context.Item.HexColor != null)
                                            {
                                                <MudChip T="string"
                                                    OnClick="() => OpenColorPopup(context.Item.HexColor, context.Item.ColorName)"
                                                    class="mud-elevation-2"
                                                    Style="@ColorHelper.ColorChipStyle(context.Item.HexColor)">
                                                    @context.Item.ColorName
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Default">N/A</MudChip>
                                            }
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Title="Quantity" Property="x => x.Quantity"/>
                            </Columns>
                        </MudDataGrid>
                    </MudCard>
                }
                </div>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="MyMinifigInfo"/>
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private List<MyMinifigInfo> _minifigInfos = [];
    private string _search = "";
    private bool _isLoading = true;

    protected override void OnInitialized()
    {
        AuthService.SessionRestored += OnSessionRestored;
        if (AuthService.IsSessionRestored) InvokeAsync(LoadDataAsync);
    }

    private void OnSessionRestored() => InvokeAsync(async () =>
    {
        if (AuthService.CurrentUser == null)
            Nav.NavigateTo("/not-authorized");
        else
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    });

    public void Dispose() => AuthService.SessionRestored -= OnSessionRestored;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task OpenImportMinifigDialog()
    {
        var dialog = await DialogService.ShowAsync<ImportMinifigDialog>("Import Minifigs",
            new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (!result.Canceled)
            await OnInitializedAsync();
    }

    private async Task LoadDataAsync()
    {
        var minifigs = await Api.GetMyMinifigsAsync();
        _minifigInfos = minifigs?.Select(m => new MyMinifigInfo { Minifig = m, Stock = m.Stock }).ToList() ?? [];
        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadMinifigBricksAsync(MyMinifigInfo info)
    {
        if (info.IsLoaded) return;
        var bricks = await Api.GetMyMinifigBricksAsync(info.Minifig.MinifigId);
        info.Bricks = bricks?.Select(b => new BrickEntry
        {
            BrickId = b.BrickId,
            ColorId = b.ColorId,
            Name = b.Name,
            PartImg = b.PartImg,
            ColorName = b.ColorName,
            HexColor = b.HexColor,
            Quantity = b.Quantity
        }).ToList() ?? [];
        info.IsLoaded = true;
        StateHasChanged();
    }

    private async void SaveMinifigOwnedStock(MyMinifigInfo info, int newValue)
    {
        if (newValue < 0) return;
        info.Stock = newValue;
        await Api.UpsertMinifigStockAsync(info.Minifig.MinifigId, newValue);
        StateHasChanged();
    }

    private bool MinifigFilterFunc(MyMinifigInfo info)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        if (info.Minifig.MinifigId.Contains(_search, StringComparison.OrdinalIgnoreCase)) return true;
        if (info.Minifig.MinifigName.Contains(_search, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private Task OpenImagePopup(string id, string name, string? imgUrl) =>
        DialogService.ShowAsync<ImagePopup>("Image Popup",
            new DialogParameters<ImagePopup>
            {
                { x => x._id, id }, { x => x._name, name }, { x => x._imgUrl, imgUrl }
            },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private Task OpenColorPopup(string hex, string name) =>
        DialogService.ShowAsync<ColorPopup>("Color Popup",
            new DialogParameters<ColorPopup>
            {
                { x => x._hexColor, hex }, { x => x._name, name }
            },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private class MyMinifigInfo
    {
        public ApiClient.MyMinifigDto Minifig { get; set; } = null!;
        public int Stock { get; set; }
        public bool IsLoaded { get; set; }
        public List<BrickEntry> Bricks { get; set; } = [];
    }

    private class BrickEntry
    {
        public string BrickId { get; set; } = "";
        public string ColorId { get; set; } = "";
        public string Name { get; set; } = "";
        public string? PartImg { get; set; }
        public string? ColorName { get; set; }
        public string? HexColor { get; set; }
        public int Quantity { get; set; }
    }
}
