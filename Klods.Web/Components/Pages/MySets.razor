@page "/my/sets"
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Components.Objects
@using Klods.Services
@using Microsoft.AspNetCore.Components.Routing
@using Color = MudBlazor.Color
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable

<PageTitle>My Sets</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">My Sets</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    @* Stats *@
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@TotalSets.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Unique Sets</MudText>
        </MudStack></MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@TotalCopies.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Owned Copies</MudText>
        </MudStack></MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@TotalPieces.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Total Pieces</MudText>
        </MudStack></MudPaper>
    </MudItem>

    @* Search + theme filter *@
    <MudItem xs="12" md="8">
        <MudTextField T="string" Value="_query" ValueChanged="OnSearch" Immediate="true" DebounceInterval="350"
                      Placeholder="Search by set name or number…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Clearable="true"/>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudAutocomplete T="string" Value="_selectedTheme" ValueChanged="OnThemeChanged"
                         SearchFunc="SearchThemes" Label="Filter by theme"
                         Variant="Variant.Outlined" Clearable="true" Placeholder="All themes"/>
    </MudItem>

    @* Toolbar: Add Set + view toggle *@
    <MudItem xs="12">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddSetDialog">
                Add Set
            </MudButton>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                @if (_view == "grid")
                {
                    <MudMenu Label="@SortLabel" StartIcon="@Icons.Material.Filled.Sort"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Outlined" Size="Size.Small">
                        @foreach (var (field, label) in _sortOptions)
                        {
                            <MudMenuItem OnClick="@(() => SetSort(field))">@label@(Arrow(field))</MudMenuItem>
                        }
                    </MudMenu>
                }
                <MudToggleGroup T="string" Value="_view" ValueChanged="OnViewChanged" Size="Size.Small"
                                Color="Color.Primary" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Dense="true">
                    <MudToggleItem Value="@("list")"><MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small"/></MudToggleItem>
                    <MudToggleItem Value="@("grid")"><MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small"/></MudToggleItem>
                </MudToggleGroup>
            </MudStack>
        </MudStack>

        @if (_setInfos.Count == 0)
        {
            <MudPaper Class="pa-8" Elevation="0">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Secondary"/>
                    <MudText Typo="Typo.h6">Your collection is empty</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width: 480px;">
                        Add your first set to get started tracking your collection.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddSetDialog">
                        Add Set
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (TotalFiltered == 0)
        {
            <MudPaper Class="pa-8" Elevation="0">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
                    <MudText Typo="Typo.h6">No sets match your filter</MudText>
                    <MudButton Variant="Variant.Text" OnClick="ClearFilters">Clear filters</MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (_view == "grid")
        {
            <div class="card-grid">
                @foreach (var r in FlatPagedItems)
                {
                    var row = r;
                    <MudPaper Class="catalog-card" Elevation="2" @onclick="() => OpenSetDetailDialog(row)">
                        <div class="card-img">
                            <MudImage Src="@ImageStorage.ResolveUrl(row.Set.SetImg)"
                                      Style="max-width:100%; max-height:100%; object-fit:contain;"/>
                        </div>
                        <div class="card-label">
                            <MudText Typo="Typo.body2" Style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@row.Set.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@row.Set.SetId · #@row.Instance.SetIndex</MudText>
                        </div>
                    </MudPaper>
                }
            </div>
        }
        else
        {
            <MudDataGrid T="FlatSetRow" Items="@FlatPagedItems.ToList()" SortMode="SortMode.None" ReadOnly="true">
                <Columns>
                    <TemplateColumn Title="Image" Editable="false">
                        <CellTemplate>
                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                      Src="@ImageStorage.ResolveUrl(context.Item.Set.SetImg)" Height="50"
                                      @onclick="() => OpenImagePopup(context.Item.Set.SetId, context.Item.Set.Name, ImageStorage.ResolveUrl(context.Item.Set.SetImg))"/>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("id")'>Id@(Arrow("id"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.SetId</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Index" Editable="false">
                        <CellTemplate>@context.Item.Instance.SetIndex</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("name")'>Name@(Arrow("name"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.Name</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("theme")'>Theme@(Arrow("theme"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.ThemeName</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("year")'>Year@(Arrow("year"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.ReleaseYear</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Stock" Editable="false">
                        <CellTemplate>@context.Item.Instance.StockCount</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Missing" Editable="false">
                        <CellTemplate>@context.Item.Instance.MissingPieceCount</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("pieces")'>Pieces@(Arrow("pieces"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.NumBricks</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Manual" Editable="false">
                        <CellTemplate>
                            <MudImage @onclick="() => OpenBuildingInstructions(context.Item.Set.ManualUrl)"
                                      class="cursor-pointer rounded-2" Elevation="2" Height="30"
                                      Src="https://logodownload.org/wp-content/uploads/2017/04/lego-logo.png"/>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="BoM" Editable="false">
                        <CellTemplate>
                            <MudIconButton
                                href=@($"/bom/{context.Item.Set.SetId}/{context.Item.Instance.SetIndex}")
                                Icon="@Icons.Material.Filled.List"
                                Variant="Variant.Filled" Color="Color.Primary"
                                Size="Size.Small"/>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Add" Editable="false">
                        <CellTemplate>
                            <MudIconButton
                                Icon="@Icons.Material.Filled.Add"
                                Variant="Variant.Filled" Color="Color.Info"
                                Size="Size.Small"
                                OnClick="() => AddOwnedSet(context.Item.Set.SetId)"/>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Delete" Editable="false">
                        <CellTemplate>
                            <MudIconButton
                                Icon="@Icons.Material.Filled.Delete"
                                Variant="Variant.Filled" Color="Color.Error"
                                Size="Size.Small"
                                OnClick="() => DeleteOwnedSet(context.Item.Set.SetId, context.Item.Instance.SetIndex, context.Item.Set.Name, ImageStorage.ResolveUrl(context.Item.Set.SetImg))"/>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }

        @if (_setInfos.Count > 0 && TotalFiltered > 0)
        {
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mt-4">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Rows per page:</MudText>
                    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 88px;">
                        <MudSelectItem Value="25">25</MudSelectItem>
                        <MudSelectItem Value="50">50</MudSelectItem>
                        <MudSelectItem Value="100">100</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@RangeText</MudText>
                </MudStack>
                @if (TotalPages > 1)
                {
                    <MudPagination Color="Color.Primary" Count="TotalPages" Selected="_page" SelectedChanged="OnPageChanged"/>
                }
            </MudStack>
        }
    </MudItem>
</MudGrid>

<style>
    .sort-head { cursor: pointer; user-select: none; font-weight: 600; }
    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; }
    .catalog-card { border-radius: 16px; overflow: hidden; cursor: pointer; display: flex; flex-direction: column;
                    transition: transform .12s ease, box-shadow .12s ease; }
    .catalog-card:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,0.25); }
    .card-img { aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; padding: 14px;
                background: var(--mud-palette-surface); }
    .card-label { padding: 8px 12px; }
</style>

@code {
    private List<SetInfo> _setInfos = [];
    private bool _isLoading = true;

    private string _query = "";
    private string? _selectedTheme;
    private string _sort = "name";
    private string _dir = "asc";
    private int _page = 1;
    private int _pageSize = 25;
    private string _view = "list";

    private static readonly (string Field, string Label)[] _sortOptions =
    [
        ("name", "Name"), ("id", "Set Number"), ("theme", "Theme"),
        ("year", "Year"), ("pieces", "Pieces"),
    ];
    private string SortLabel => "Sort: " + (_sortOptions.FirstOrDefault(o => o.Field == _sort).Label ?? "Name");

    // ── Stats ──────────────────────────────────────────────────────────────────
    private int TotalSets => _setInfos.Count;
    private int TotalCopies => _setInfos.Sum(s => s.OwnedSets.Count);
    private long TotalPieces => _setInfos.Sum(s => (long)s.Set.NumBricks * s.OwnedSets.Count);

    // ── Derived theme list ─────────────────────────────────────────────────────
    private IEnumerable<string> AvailableThemes => _setInfos
        .Select(s => s.Set.ThemeName ?? "")
        .Where(t => t.Length > 0)
        .Distinct()
        .OrderBy(t => t);

    // ── Filter / sort / page pipeline ─────────────────────────────────────────
    private IEnumerable<FlatSetRow> FlatFilteredItems => _setInfos
        .SelectMany(s => s.OwnedSets.Select(o => new FlatSetRow(s.Set, o)))
        .Where(r =>
            (string.IsNullOrWhiteSpace(_query) ||
             r.Set.SetId.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
             r.Set.Name.Contains(_query, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_selectedTheme) || r.Set.ThemeName == _selectedTheme));

    private IEnumerable<FlatSetRow> FlatSortedItems
    {
        get
        {
            var asc = _dir == "asc";
            return _sort switch
            {
                "id"     => asc ? FlatFilteredItems.OrderBy(r => r.Set.SetId)       : FlatFilteredItems.OrderByDescending(r => r.Set.SetId),
                "theme"  => asc ? FlatFilteredItems.OrderBy(r => r.Set.ThemeName)   : FlatFilteredItems.OrderByDescending(r => r.Set.ThemeName),
                "year"   => asc ? FlatFilteredItems.OrderBy(r => r.Set.ReleaseYear) : FlatFilteredItems.OrderByDescending(r => r.Set.ReleaseYear),
                "pieces" => asc ? FlatFilteredItems.OrderBy(r => r.Set.NumBricks)   : FlatFilteredItems.OrderByDescending(r => r.Set.NumBricks),
                _        => asc ? FlatFilteredItems.OrderBy(r => r.Set.Name)        : FlatFilteredItems.OrderByDescending(r => r.Set.Name),
            };
        }
    }

    private IEnumerable<FlatSetRow> FlatPagedItems => FlatSortedItems.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private int TotalFiltered => FlatFilteredItems.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalFiltered / (double)_pageSize));

    private string RangeText
    {
        get
        {
            if (TotalFiltered == 0) return "0 of 0";
            var from = (_page - 1) * _pageSize + 1;
            var to = Math.Min(_page * _pageSize, TotalFiltered);
            return $"{from:N0}–{to:N0} of {TotalFiltered:N0}";
        }
    }

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        AuthService.SessionRestored += OnSessionRestored;
    }

    protected override async Task OnInitializedAsync()
    {
        ParseUrl();
        await LoadDataAsync();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        AuthService.SessionRestored -= OnSessionRestored;
    }

    private void OnSessionRestored() => InvokeAsync(async () =>
    {
        if (AuthService.CurrentUser == null) { Nav.NavigateTo("/not-authorized"); return; }
        ParseUrl();
        await LoadDataAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(() => { ParseUrl(); StateHasChanged(); });

    // ── URL state ─────────────────────────────────────────────────────────────
    private void ParseUrl()
    {
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        _query = qs["q"] ?? "";
        _selectedTheme = qs["theme"] is { Length: > 0 } t ? t : null;
        _sort = qs["sort"] ?? "name";
        _dir = qs["dir"] ?? "asc";
        _page = int.TryParse(qs["page"], out var p) && p > 0 ? p : 1;
        _pageSize = int.TryParse(qs["size"], out var sz) && sz is 25 or 50 or 100 ? sz : 25;
        _view = qs["view"] == "grid" ? "grid" : "list";
    }

    private void Navigate()
    {
        var parts = new List<string>();
        var q = _query.Trim();
        if (q.Length > 0) parts.Add($"q={Uri.EscapeDataString(q)}");
        if (!string.IsNullOrEmpty(_selectedTheme)) parts.Add($"theme={Uri.EscapeDataString(_selectedTheme)}");
        if (_sort != "name") parts.Add($"sort={_sort}");
        if (_dir != "asc") parts.Add($"dir={_dir}");
        if (_pageSize != 25) parts.Add($"size={_pageSize}");
        if (_view != "list") parts.Add($"view={_view}");
        if (_page > 1) parts.Add($"page={_page}");
        Nav.NavigateTo("/my/sets" + (parts.Count > 0 ? "?" + string.Join("&", parts) : ""));
    }

    // ── Data ──────────────────────────────────────────────────────────────────
    private async Task LoadDataAsync()
    {
        var owned = await Api.GetMyOwnedSetsAsync();
        _setInfos = owned?.Select(s => new SetInfo { Set = s, OwnedSets = s.Instances }).ToList() ?? [];
        _isLoading = false;
        StateHasChanged();
    }

    // ── Search / filter / sort / page handlers ────────────────────────────────
    private void OnSearch(string value) { _query = value ?? ""; _page = 1; Navigate(); }
    private void OnThemeChanged(string? theme) { _selectedTheme = theme; _page = 1; Navigate(); }
    private void OnViewChanged(string view) { _view = view == "grid" ? "grid" : "list"; Navigate(); }
    private void OnPageChanged(int page) { _page = page; Navigate(); }
    private void OnPageSizeChanged(int size) { _pageSize = size; _page = 1; Navigate(); }
    private void ClearFilters() { _query = ""; _selectedTheme = null; _page = 1; Navigate(); }

    private void SetSort(string field)
    {
        if (_sort == field)
            _dir = _dir == "asc" ? "desc" : "asc";
        else
        {
            _sort = field;
            _dir = field is "count" or "pieces" or "year" ? "desc" : "asc";
        }
        _page = 1;
        Navigate();
    }

    private string Arrow(string field) => field == _sort ? (_dir == "asc" ? " ▲" : " ▼") : "";

    private Task<IEnumerable<string>> SearchThemes(string value, CancellationToken token)
        => Task.FromResult<IEnumerable<string>>(
            AvailableThemes.Where(t => string.IsNullOrEmpty(value) || t.Contains(value, StringComparison.OrdinalIgnoreCase)));

    // ── Dialogs ───────────────────────────────────────────────────────────────
    private async Task OpenAddSetDialog()
    {
        var dialog = await DialogService.ShowAsync<AddOwnedSetDialog>("Add Set",
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadDataAsync();
    }

    private async Task OpenSetDetailDialog(FlatSetRow row)
    {
        var totalOwned = _setInfos.FirstOrDefault(si => si.Set.SetId == row.Set.SetId)?.OwnedSets.Count ?? 1;
        var dto = new ApiClient.SetCatalogSearchDto(
            row.Set.SetId, row.Set.Name, row.Set.SetImg,
            row.Set.NumBricks, row.Set.ReleaseYear,
            row.Set.ThemeName, row.Set.ManualUrl,
            totalOwned);
        var parameters = new DialogParameters<SetDetailDialog>
        {
            { x => x.Set, dto },
            { x => x.Owned, totalOwned }
        };
        var dialog = await DialogService.ShowAsync<SetDetailDialog>(row.Set.Name, parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadDataAsync();
    }

    private Task OpenImagePopup(string setId, string setName, string? setImgUrl) =>
        DialogService.ShowAsync<ImagePopup>("Image Popup",
            new DialogParameters<ImagePopup> { { x => x._id, setId }, { x => x._name, setName }, { x => x._imgUrl, setImgUrl } },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private void OpenBuildingInstructions(string url) => JsRuntime.InvokeVoidAsync("open", url, "_blank");

    private async Task AddOwnedSet(string setId)
    {
        await Api.AddOwnedSetAsync(setId);
        await LoadDataAsync();
    }

    private async Task DeleteOwnedSet(string setId, int setIndex, string setName, string? setImgUrl)
    {
        var parameters = new DialogParameters<DeleteIndexPopup>
        {
            { x => x._id, setId }, { x => x._setIndex, setIndex },
            { x => x._name, setName }, { x => x._imgUrl, setImgUrl }
        };
        var dialog = await DialogService.ShowAsync<DeleteIndexPopup>("Delete Popup", parameters,
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            var setInfo = _setInfos.FirstOrDefault(si => si.Set.SetId == setId);
            if (setInfo != null)
            {
                setInfo.OwnedSets.RemoveAll(i => i.SetIndex == setIndex);
                if (setInfo.OwnedSets.Count == 0)
                    _setInfos.Remove(setInfo);
            }
            StateHasChanged();
        }
    }

    private class SetInfo
    {
        public ApiClient.MyOwnedSetDto Set { get; set; } = null!;
        public List<ApiClient.OwnedInstanceDto> OwnedSets { get; set; } = [];
    }

    private record FlatSetRow(ApiClient.MyOwnedSetDto Set, ApiClient.OwnedInstanceDto Instance);
}
