@page "/sets"
@inject ILoggerFactory LoggerFactory
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@inject AuthService AuthService
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Components.Objects
@using Klods.Services
@using Color = MudBlazor.Color
@rendermode InteractiveServer

<PageTitle>Sets</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">Sets</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    @* Stats *@
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalSets.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Sets in Catalog</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalOwnedInstances</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Owned Instances</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalOwners</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Collectors</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalPieces.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Pieces</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* Search *@
    <MudItem xs="12">
        <MudTextField T="string" Value="_query" ValueChanged="OnQueryChanged"
                      Immediate="true" DebounceInterval="350"
                      Placeholder="Search the catalog by set name or number — or just browse the latest below…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Clearable="true"/>
    </MudItem>

    @* Catalog (server-paginated; latest sets by default) *@
    <MudItem xs="12">
        <MudDataGrid T="SetCatalogRow" @ref="_grid" ServerData="LoadServerData"
                     SortMode="SortMode.None" ReadOnly="true">
            <Columns>
                <TemplateColumn Title="Image" Editable="false">
                    <CellTemplate>
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                            <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                      Src="@ImageStorage.ResolveUrl(context.Item.Set.SetImg)" Height="50"
                                      @onclick="() => OpenImagePopup(context.Item.Set.SetId, context.Item.Set.Name, ImageStorage.ResolveUrl(context.Item.Set.SetImg))"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Set.SetId" Title="Id" Editable="false"/>
                <PropertyColumn Property="x => x.Set.Name" Title="Name" Editable="false"/>
                <PropertyColumn Property="x => x.Set.ReleaseYear" Title="Year" Editable="false"/>
                <PropertyColumn Property="x => x.Set.NumBricks" Title="Pieces" Editable="false"/>
                <TemplateColumn Title="Owned" Editable="false">
                    <CellTemplate>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                           Size="Size.Small"
                                           Disabled="@(context.Item.UserOwnedCount == 0 || AuthService.CurrentUser == null)"
                                           OnClick="() => DecrementOwned(context.Item)"/>
                            <MudText Style="min-width: 20px; text-align: center;">@context.Item.UserOwnedCount</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Disabled="@(AuthService.CurrentUser == null)"
                                           OnClick="() => IncrementOwned(context.Item)"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Manual" Editable="false">
                    <CellTemplate>
                        <MudImage @onclick="() => OpenBuildingInstructions(context.Item.Set.ManualUrl)"
                                  class="cursor-pointer rounded-2" Elevation="2" Height="30"
                                  Src="https://logodownload.org/wp-content/uploads/2017/04/lego-logo.png"/>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                @if (_query.Trim().Length >= 2)
                {
                    <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
                        <MudText Typo="Typo.h6">No sets match “@_query”</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width: 480px;">
                            Double-check the spelling or try the set number (e.g. <em>75192-1</em>). If it's a brand-new
                            set that isn't in our catalog yet, you can pull it straight from Rebrickable.
                        </MudText>
                        <MudTooltip Text="@(AuthService.CurrentUser == null ? "You must be logged in to import sets" : "Import from Rebrickable")">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@(AuthService.CurrentUser == null ? Icons.Material.Filled.Lock : Icons.Material.Filled.Download)"
                                       Disabled="@(AuthService.CurrentUser == null)"
                                       OnClick="OpenImportDialog">
                                Import a set from Rebrickable
                            </MudButton>
                        </MudTooltip>
                    </MudStack>
                }
                else
                {
                    <MudText Class="pa-6" Align="Align.Center" Color="Color.Secondary">No sets found.</MudText>
                }
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="SetCatalogRow"/>
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private MudDataGrid<SetCatalogRow> _grid = null!;
    private string _query = "";
    private int _totalSets;
    private int _totalOwnedInstances;
    private int _totalOwners;
    private long _totalPieces;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var stats = await Api.GetSetCatalogStatsAsync();
        if (stats != null)
        {
            _totalSets = stats.TotalSets;
            _totalOwnedInstances = stats.TotalOwnedInstances;
            _totalOwners = stats.TotalOwners;
            _totalPieces = stats.TotalPieces;
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task<GridData<SetCatalogRow>> LoadServerData(GridState<SetCatalogRow> state)
    {
        var page = await Api.GetSetsCatalogPageAsync(_query.Trim(), state.Page, state.PageSize);
        var rows = (page?.Items ?? []).Select(s => new SetCatalogRow { Set = s, UserOwnedCount = s.UserOwnedCount }).ToList();
        return new GridData<SetCatalogRow> { Items = rows, TotalItems = page?.Total ?? 0 };
    }

    private async Task OnQueryChanged(string value)
    {
        _query = value ?? "";
        if (_grid is not null) await _grid.ReloadServerData();
    }

    private async Task OpenImportDialog()
    {
        var dialog = await DialogService.ShowAsync<ImportSetDialog>("Import Sets",
            new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await OnInitializedAsync();
            if (_grid is not null) await _grid.ReloadServerData();
        }
    }

    private async Task IncrementOwned(SetCatalogRow row)
    {
        if (AuthService.CurrentUser == null) return;
        if (await Api.AddOwnedSetAsync(row.Set.SetId))
        {
            row.UserOwnedCount++;
            _totalOwnedInstances++;
            StateHasChanged();
        }
    }

    private async Task DecrementOwned(SetCatalogRow row)
    {
        if (AuthService.CurrentUser == null || row.UserOwnedCount == 0) return;
        if (await Api.DeleteLastOwnedSetAsync(row.Set.SetId))
        {
            row.UserOwnedCount--;
            _totalOwnedInstances--;
            StateHasChanged();
        }
    }

    private Task OpenImagePopup(string setId, string setName, string? setImgUrl)
    {
        var parameters = new DialogParameters<ImagePopup>
        {
            { x => x._id, setId },
            { x => x._name, setName },
            { x => x._imgUrl, setImgUrl }
        };
        return DialogService.ShowAsync<ImagePopup>("Image Popup", parameters,
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
    }

    private void OpenBuildingInstructions(string url)
    {
        JsRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private class SetCatalogRow
    {
        public ApiClient.SetCatalogSearchDto Set { get; set; } = null!;
        public int UserOwnedCount { get; set; }
    }
}
