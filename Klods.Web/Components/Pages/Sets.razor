@page "/sets"
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthService AuthService
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Components.Objects
@using Klods.Services
@using Microsoft.AspNetCore.Components.Routing
@using Color = MudBlazor.Color
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Sets</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">Sets</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    @* Stats *@
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalSets.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Sets in Catalog</MudText>
        </MudStack></MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalOwnedInstances</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Owned Instances</MudText>
        </MudStack></MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalOwners</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Collectors</MudText>
        </MudStack></MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2"><MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">@_totalPieces.ToString("N0")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Total Pieces</MudText>
        </MudStack></MudPaper>
    </MudItem>

    @* Search + theme filter *@
    <MudItem xs="12" md="8">
        <MudTextField T="string" Value="_query" ValueChanged="OnSearch" Immediate="true" DebounceInterval="350"
                      Placeholder="Search by set name or number — or just browse the latest below…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Clearable="true"/>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudAutocomplete T="ApiClient.ThemeDto" Value="_selectedTheme" ValueChanged="OnThemeChanged"
                         SearchFunc="SearchThemes" ToStringFunc="@(t => t?.Name ?? "")"
                         Label="Filter by theme" Variant="Variant.Outlined" Clearable="true"
                         Placeholder="All themes"/>
    </MudItem>

    @* Results *@
    <MudItem xs="12">
        <MudStack Row Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            @if (_view == "grid")
            {
                <MudMenu Label="@SortLabel" StartIcon="@Icons.Material.Filled.Sort"
                         EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Outlined" Size="Size.Small">
                    @foreach (var (field, label) in _sortOptions)
                    {
                        <MudMenuItem OnClick="@(() => SetSort(field))">@label@(Arrow(field))</MudMenuItem>
                    }
                </MudMenu>
            }
            <MudToggleGroup T="string" Value="_view" ValueChanged="OnViewChanged" Size="Size.Small"
                            Color="Color.Primary" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Dense="true">
                <MudToggleItem Value="@("list")"><MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small"/></MudToggleItem>
                <MudToggleItem Value="@("grid")"><MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small"/></MudToggleItem>
            </MudToggleGroup>
        </MudStack>

        @if (_loadingResults)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-8"><MudProgressCircular Indeterminate="true"/></MudStack>
        }
        else if (_rows.Count == 0)
        {
            <MudPaper Class="pa-8" Elevation="0">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
                    <MudText Typo="Typo.h6">No sets match your search</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width: 480px;">
                        Try a different spelling, theme, or the set number (e.g. <em>75192-1</em>). Brand-new sets not in
                        the catalog yet can be pulled from Rebrickable.
                    </MudText>
                    <MudTooltip Text="@(AuthService.CurrentUser == null ? "You must be logged in to import sets" : "Import from Rebrickable")">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@(AuthService.CurrentUser == null ? Icons.Material.Filled.Lock : Icons.Material.Filled.Download)"
                                   Disabled="@(AuthService.CurrentUser == null)" OnClick="OpenImportDialog">
                            Import a set from Rebrickable
                        </MudButton>
                    </MudTooltip>
                </MudStack>
            </MudPaper>
        }
        else
        {
            @if (_view == "grid")
            {
                <div class="card-grid">
                    @foreach (var row in _rows)
                    {
                        var r = row;
                        <MudPaper Class="catalog-card" Elevation="2" @onclick="() => OpenSetDialog(r)">
                            <div class="card-img"><MudImage Src="@ImageStorage.ResolveUrl(r.Set.SetImg)" Style="max-width:100%; max-height:100%; object-fit:contain;"/></div>
                            <div class="card-label">
                                <MudText Typo="Typo.body2" Style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@r.Set.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@r.Set.SetId@(r.UserOwnedCount > 0 ? $" · owned ×{r.UserOwnedCount}" : "")</MudText>
                            </div>
                        </MudPaper>
                    }
                </div>
            }
            else
            {
            <MudDataGrid T="SetCatalogRow" Items="_rows" SortMode="SortMode.None" ReadOnly="true"
                         Hover="true" RowClass="cursor-pointer" RowClick="@(args => OpenSetDialog(args.Item))">
                <Columns>
                    <TemplateColumn Title="Image" Editable="false">
                        <CellTemplate>
                            <MudImage class="rounded-3" Elevation="2"
                                      Src="@ImageStorage.ResolveUrl(context.Item.Set.SetImg)" Height="50"/>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("id")'>Id@(Arrow("id"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.SetId</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("name")'>Name@(Arrow("name"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.Name</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("theme")'>Theme@(Arrow("theme"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.ThemeName</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("year")'>Year@(Arrow("year"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.ReleaseYear</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Editable="false">
                        <HeaderTemplate><span class="sort-head" @onclick='() => SetSort("pieces")'>Pieces@(Arrow("pieces"))</span></HeaderTemplate>
                        <CellTemplate>@context.Item.Set.NumBricks</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Owned" Editable="false">
                        <CellTemplate>@context.Item.UserOwnedCount</CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
            }

            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mt-4">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Rows per page:</MudText>
                    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 88px;">
                        <MudSelectItem Value="25">25</MudSelectItem>
                        <MudSelectItem Value="50">50</MudSelectItem>
                        <MudSelectItem Value="100">100</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@RangeText</MudText>
                </MudStack>
                @if (_totalPages > 1)
                {
                    <MudPagination Color="Color.Primary" Count="_totalPages" Selected="_page" SelectedChanged="OnPageChanged"/>
                }
            </MudStack>
        }
    </MudItem>
</MudGrid>

<style>
    .sort-head { cursor: pointer; user-select: none; font-weight: 600; }
    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; }
    .catalog-card { border-radius: 16px; overflow: hidden; cursor: pointer; display: flex; flex-direction: column;
                    transition: transform .12s ease, box-shadow .12s ease; }
    .catalog-card:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,0.25); }
    .card-img { aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; padding: 14px;
                background: var(--mud-palette-surface); }
    .card-label { padding: 8px 12px; }
</style>

@code {
    private List<SetCatalogRow> _rows = [];
    private List<ApiClient.ThemeDto> _themes = [];
    private ApiClient.ThemeDto? _selectedTheme;

    private string _query = "";
    private int? _theme;
    private string _sort = "year";
    private static readonly (string Field, string Label)[] _sortOptions =
    [
        ("year", "Year"), ("name", "Name"), ("id", "Set Number"),
        ("theme", "Theme"), ("pieces", "Pieces"),
    ];
    private string SortLabel => "Sort: " + (_sortOptions.FirstOrDefault(o => o.Field == _sort).Label ?? "Year");
    private string _dir = "desc";
    private int _page = 1;
    private int _pageSize = 25;
    private string _view = "grid";

    private int _total;
    private int _totalPages = 1;

    private string RangeText
    {
        get
        {
            if (_total == 0) return "0 of 0";
            var from = (_page - 1) * _pageSize + 1;
            var to = Math.Min(_page * _pageSize, _total);
            return $"{from:N0}–{to:N0} of {_total:N0}";
        }
    }

    private int _totalSets, _totalOwnedInstances, _totalOwners;
    private long _totalPieces;

    private bool _isLoading = true;
    private bool _loadingResults;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnInitializedAsync()
    {
        var stats = await Api.GetSetCatalogStatsAsync();
        if (stats != null)
        {
            _totalSets = stats.TotalSets;
            _totalOwnedInstances = stats.TotalOwnedInstances;
            _totalOwners = stats.TotalOwners;
            _totalPieces = stats.TotalPieces;
        }
        _themes = (await Api.GetSetThemesAsync())?.ToList() ?? [];

        ParseUrl();
        await LoadAsync();
        _isLoading = false;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(async () => { ParseUrl(); await LoadAsync(); });

    private void ParseUrl()
    {
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        _query = qs["q"] ?? "";
        _theme = int.TryParse(qs["theme"], out var t) ? t : null;
        _selectedTheme = _theme is int id ? _themes.FirstOrDefault(x => x.Id == id) : null;
        _sort = qs["sort"] ?? "year";
        _dir = qs["dir"] ?? "desc";
        _page = int.TryParse(qs["page"], out var p) && p > 0 ? p : 1;
        _pageSize = int.TryParse(qs["size"], out var sz) && sz is 25 or 50 or 100 ? sz : 25;
        _view = qs["view"] == "list" ? "list" : "grid";
    }

    private async Task LoadAsync()
    {
        _loadingResults = true;
        StateHasChanged();

        var page = await Api.GetSetsCatalogPageAsync(_query.Trim(), _theme, _sort, _dir, _page - 1, _pageSize);
        _rows = (page?.Items ?? []).Select(s => new SetCatalogRow { Set = s, UserOwnedCount = s.UserOwnedCount }).ToList();
        _total = page?.Total ?? 0;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

        _loadingResults = false;
        StateHasChanged();
    }

    private void Navigate()
    {
        var parts = new List<string>();
        var q = _query.Trim();
        if (q.Length > 0) parts.Add($"q={Uri.EscapeDataString(q)}");
        if (_theme is int t) parts.Add($"theme={t}");
        if (_sort != "year") parts.Add($"sort={_sort}");
        if (_dir != "desc") parts.Add($"dir={_dir}");
        if (_pageSize != 25) parts.Add($"size={_pageSize}");
        if (_view != "grid") parts.Add($"view={_view}");
        if (_page > 1) parts.Add($"page={_page}");
        Nav.NavigateTo("/sets" + (parts.Count > 0 ? "?" + string.Join("&", parts) : ""));
    }

    private void OnViewChanged(string view)
    {
        _view = view == "grid" ? "grid" : "list";
        Navigate();
    }

    private async Task OpenSetDialog(SetCatalogRow row)
    {
        var parameters = new DialogParameters<SetDetailDialog> { { x => x.Set, row.Set }, { x => x.Owned, row.UserOwnedCount } };
        var dialog = await DialogService.ShowAsync<SetDetailDialog>(row.Set.Name, parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: int newOwned })
        {
            _totalOwnedInstances += newOwned - row.UserOwnedCount;
            row.UserOwnedCount = newOwned;
            StateHasChanged();
        }
    }

    private void OnSearch(string value)
    {
        _query = value ?? "";
        _page = 1;
        Navigate();
    }

    private void OnThemeChanged(ApiClient.ThemeDto? theme)
    {
        _selectedTheme = theme;
        _theme = theme?.Id;
        _page = 1;
        Navigate();
    }

    private void SetSort(string field)
    {
        if (_sort == field)
            _dir = _dir == "asc" ? "desc" : "asc";
        else
        {
            _sort = field;
            _dir = field is "name" or "id" or "theme" ? "asc" : "desc";
        }
        _page = 1;
        Navigate();
    }

    private void OnPageChanged(int page)
    {
        _page = page;
        Navigate();
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        Navigate();
    }

    private string Arrow(string field) => field == _sort ? (_dir == "asc" ? " ▲" : " ▼") : "";

    private Task<IEnumerable<ApiClient.ThemeDto>> SearchThemes(string value, CancellationToken token)
        => Task.FromResult<IEnumerable<ApiClient.ThemeDto>>(
            _themes.Where(t => string.IsNullOrEmpty(value) || t.Name.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(50));

    private async Task OpenImportDialog()
    {
        var dialog = await DialogService.ShowAsync<ImportSetDialog>("Import Sets",
            new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result).Canceled)
            await LoadAsync();
    }

    private class SetCatalogRow
    {
        public ApiClient.SetCatalogSearchDto Set { get; set; } = null!;
        public int UserOwnedCount { get; set; }
    }
}
