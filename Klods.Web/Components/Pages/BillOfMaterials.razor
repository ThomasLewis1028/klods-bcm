@page "/bom/{_setId?}/{_setIndex?}"
@page "/bom/{_setId?}"
@page "/bom"
@inject ILoggerFactory LoggerFactory
@inject IDialogService DialogService
@inject NavigationManager navigationManager
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject AuthService AuthService
@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using System.Drawing
@using Klods.Components.Objects
@using Klods.Services
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable

<PageTitle>@_pageTitle</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">Bill of Materials</MudText>

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudGrid>
    <MudItem xs="3">
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="ApiClient.MyOwnedSetDto"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Value="_selectedOwnedSet"
                           ValueChanged="ChangeSet">
                    @foreach (var set in _ownedSets)
                    {
                        <MudSelectItem Value="@set">@set.SetId - @set.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_selectedOwnedSet != null)
            {
                <MudItem xs="12">
                    <MudSelect T="int"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Value="_currentSetIndex"
                               ValueChanged="ChangeIndex">
                        @foreach (var idx in _ownedInstances)
                        {
                            <MudSelectItem Value="@idx">Owned Set Index: @idx</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
    </MudItem>
    @if (_selectedOwnedSet != null)
    {
        <MudItem xs="9" Style="height: 100%">
            <MudGrid>
                <MudItem xs="3">
                    <MudImage class="cursor-pointer rounded-2"
                              Elevation="2"
                              Src="@ImageStorage.ResolveUrl(_selectedOwnedSet.SetImg)"
                              Style="height: 150px;"
                              ObjectFit="ObjectFit.Contain"
                              @onclick="((e) => OpenImagePopup(_selectedOwnedSet.SetId, _selectedOwnedSet.Name, ImageStorage.ResolveUrl(_selectedOwnedSet.SetImg)))"/>
                </MudItem>
                <MudItem xs="6">
                    <MudGrid xs="12">
                        <MudItem xs="12">
                            <MudText Align="Align.Center" Typo="Typo.h6">@_setId</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Align="Align.Center" Typo="Typo.h6">@_selectedOwnedSet.Name</MudText>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="3">
                    <MudImage @onclick="() => OpenBuildingInstructions(_selectedOwnedSet.ManualUrl)"
                              class="cursor-pointer rounded-2"
                              Elevation="2"
                              Style="height: 150px"
                              ObjectFit="ObjectFit.Contain"
                              Src="https://logodownload.org/wp-content/uploads/2017/04/lego-logo.png"/>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="12">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                @* Brick Tab *@
                <MudTabPanel Text="Bricks">
                    <MudDataGrid T="SetBrickInfo" Items="@_setBrickInfo.OrderBy(b => b.Brick.PartNum)"
                                 SortMode="@SortMode.Multiple" EditMode="DataGridEditMode.Cell"
                                 QuickFilter="SetBrickFilterFunc" CommittedItemChanges="@UpdateBrick"
                                 ReadOnly="false" Bordered="false">
                        <ToolBarContent>
                            <MudText Typo="Typo.body1">Missing
                                Pieces: @_setBrickInfo.Sum(sb => sb.Brick.Count - sb.SetStock)
                            </MudText>
                            <MudSpacer/>
                            <MudSwitch
                                @bind-Value="_showMissing"
                                UncheckedColor="Color.Default"
                                Color="Color.Error"
                                Label="Show Missing"
                                LabelPlacement="Placement.Start"/>
                            <MudSpacer/>
                            <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start"
                                          Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium"
                                          Class="mt-0"></MudTextField>
                        </ToolBarContent>
                        <Columns>
                            <TemplateColumn Title="Image" Editable="false">
                                <CellTemplate>
                                    <MudStack Row>
                                        <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                                  Src="@ImageStorage.ResolveUrl(context.Item.Brick.PartImg)" Height="50"
                                                  @onclick="((e) => OpenImagePopup(context.Item.Brick.PartNum, context.Item.Brick.Name, ImageStorage.ResolveUrl(context.Item.Brick.PartImg)))"/>
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Brick.PartNum" Title="Brick Id" Editable="false"/>
                            <PropertyColumn Property="x => x.Brick.Name" Title="Name" Editable="false"/>
                            <TemplateColumn Title="Color" SortBy="x => x.Brick.ColorId" Sortable="true"
                                            Editable="false">
                                <CellTemplate>
                                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                                        @if (context.Item.Brick.HexColor != null)
                                        {
                                            @if (ColorHelper.IsDark(context.Item.Brick.HexColor))
                                            {
                                                <MudChip
                                                    OnClick="() => OpenColorPopup(context.Item.Brick.HexColor, context.Item.Brick.ColorName)"
                                                    class="mud-elevation-2"
                                                    Style="@($"background-color: {"#" + context.Item.Brick.HexColor}; width: -moz-available;")">@context.Item.Brick.ColorName</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip
                                                    OnClick="() => OpenColorPopup(context.Item.Brick.HexColor, context.Item.Brick.ColorName)"
                                                    class="mud-elevation-2"
                                                    Style="@($"background-color: {"#" + context.Item.Brick.HexColor}; color: #202020; width: -moz-available;")">@context.Item.Brick.ColorName</MudChip>
                                            }
                                        }
                                        else
                                        {
                                            <MudChip Color="default">N/A</MudChip>
                                        }
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Need (Spare)" Editable="false"
                                            SortBy="x => x.Brick.Count + x.Brick.SpareCount" Sortable="true">
                                <CellTemplate>
                                    <MudStack Row Spacing="1">
                                        @{
                                            var stock = context.Item.SetStock;
                                        }
                                        @if (context.Item.Brick.Count <= stock)
                                        {
                                            <MudText Color="@Color.Success">@context.Item.Brick.Count</MudText>
                                        }
                                        else if (context.Item.Brick.Count - stock <= context.Item.LooseStock)
                                        {
                                            <MudText Color="@Color.Warning">@context.Item.Brick.Count</MudText>
                                        }
                                        else
                                        {
                                            <MudText Color="@Color.Error">@context.Item.Brick.Count</MudText>
                                        }
                                        @if (context.Item.Brick.SpareCount > 0)
                                        {
                                            <MudText Style="padding: -10px">(@context.Item.Brick.SpareCount)
                                            </MudText>
                                        }
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Stock Used" Editable="false"
                                            SortBy="x => x.SetStock">
                                <CellTemplate>
                                    <MudNumericField T="int"
                                                     Value="@context.Item.SetStock"
                                                     ValueChanged="@(v => SaveSetBrickOwnedStock(context.Item, v))"
                                                     Min="0"
                                                     Disabled="@(AuthService.CurrentUser == null)"
                                                     Variant="Variant.Text"/>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Move Stock" Editable="false">
                                <CellTemplate>
                                    <MudStack Row Spacing="0">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowLeft"
                                                       OnClick="() => MoveBrickStock(Direction.left, context.Item)"/>
                                        <MudNumericField Variant="Variant.Outlined" Min="0"
                                                         @bind-Value="context.Item.MoveCount"></MudNumericField>
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowRight"
                                                       OnClick="() => MoveBrickStock(Direction.right, context.Item)"/>
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="My Stock" Editable="false"
                                            SortBy="x => x.LooseStock">
                                <CellTemplate>
                                    <MudNumericField T="int"
                                                     Value="@context.Item.LooseStock"
                                                     ValueChanged="@(v => SaveBrickOwnedStock(context.Item, v))"
                                                     Min="0"
                                                     Disabled="@(AuthService.CurrentUser == null)"
                                                     Variant="Variant.Text"/>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="SetBrickInfo"/>
                        </PagerContent>
                    </MudDataGrid>
                </MudTabPanel>

                @* Minifigure Tab *@
                <MudTabPanel Text="Minifigures" Disabled="@(_setMinifigInfo.Count == 0)">
                    <MudDataGrid T="SetMinifigInfo" Items="@_setMinifigInfo.OrderBy(b => b.Minifig.MinifigId)"
                                 SortMode="@SortMode.Multiple" EditMode="DataGridEditMode.Cell"
                                 QuickFilter="SetMinifigFilterFunc" CommittedItemChanges="@UpdateMinifig"
                                 ReadOnly="false">
                        <ToolBarContent>
                            <MudSpacer/>
                            <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start"
                                          Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium"
                                          Class="mt-0"></MudTextField>
                        </ToolBarContent>
                        <Columns>
                            <HierarchyColumn/>
                            <TemplateColumn Title="Image" Editable="false">
                                <CellTemplate>
                                    <MudStack Row>
                                        <MudImage class="cursor-pointer rounded-2" Elevation="2"
                                                  Src="@ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl)" Height="50"
                                                  @onclick="((e) => OpenImagePopup(context.Item.Minifig.MinifigId, context.Item.Minifig.Name, ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl)))"/>
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Minifig.MinifigId" Title="Minifig Id" Editable="false"/>
                            <PropertyColumn Property="x => x.Minifig.Name" Title="Name" Editable="false"/>
                            <PropertyColumn Property="x => x.Minifig.Count" Title="Needed" Editable="false"/>
                            <TemplateColumn Title="My Stock" Editable="false"
                                            SortBy="x => x.OwnedStock">
                                <CellTemplate>
                                    <MudNumericField T="int"
                                                     Value="@context.Item.OwnedStock"
                                                     ValueChanged="@(v => SaveMinifigOwnedStock(context.Item, v))"
                                                     Min="0"
                                                     Disabled="@(AuthService.CurrentUser == null)"
                                                     Variant="Variant.Text"/>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>

                        <ChildRowContent Context="minifigContext">
                            <MudCard>
                                <MudDataGrid T="SetBrickInfo" Items="@minifigContext.Item.BomBricks">
                                    <Columns>
                                        <TemplateColumn Title="Image">
                                            <CellTemplate>
                                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                                                    <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                                              Src="@ImageStorage.ResolveUrl(context.Item.Brick.PartImg)" Height="50"
                                                              @onclick="((e) => OpenImagePopup(context.Item.Brick.PartNum, context.Item.Brick.Name, ImageStorage.ResolveUrl(context.Item.Brick.PartImg)))"/>
                                                </MudStack>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Title="Brick Id" Property="x => x.Brick.PartNum"/>
                                        <PropertyColumn Title="Name" Property="x => x.Brick.Name"/>
                                        <TemplateColumn Title="Need" Editable="false"
                                                        SortBy="x => x.Brick.Count"
                                                        Sortable="true">
                                            <CellTemplate>
                                                <MudText>@context.Item.Brick.Count</MudText>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Stock Used">
                                            <CellTemplate>
                                                <MudNumericField T="int"
                                                                 Value="@context.Item.SetStock"
                                                                 ValueChanged="@(v => SaveMinifigBrickOwnedStock(minifigContext.Item, context.Item, v))"
                                                                 Min="0"
                                                                 Disabled="@(AuthService.CurrentUser == null)"
                                                                 Variant="Variant.Text"/>
                                            </CellTemplate>
                                        </TemplateColumn>
                                    </Columns>
                                </MudDataGrid>
                            </MudCard>
                        </ChildRowContent>
                        <PagerContent>
                            <MudDataGridPager T="SetMinifigInfo"/>
                        </PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter] public string? _setId { get; set; }
    [Parameter] public string? _setIndex { get; set; }

    protected override void OnInitialized()
    {
        AuthService.SessionRestored += OnSessionRestored;
        if (AuthService.IsSessionRestored) CheckAuth();
    }

    private void OnSessionRestored() => InvokeAsync(async () =>
    {
        CheckAuth();
        await OnInitializedAsync();
        StateHasChanged();
    });

    private void CheckAuth()
    {
        if (AuthService.CurrentUser == null)
            Nav.NavigateTo("/not-authorized");
    }

    public void Dispose() => AuthService.SessionRestored -= OnSessionRestored;

    private string _pageTitle = "Bill of Materials";

    private List<SetBrickInfo> _setBrickInfo = new();
    private List<SetMinifigInfo> _setMinifigInfo = new();
    private List<ApiClient.MyOwnedSetDto> _ownedSets = new();
    private List<int> _ownedInstances = new();
    private string searchString = "";
    private bool _showMissing = false;
    private bool _isLoading = true;

    private ApiClient.MyOwnedSetDto? _selectedOwnedSet;
    private int _currentSetIndex;

    protected override async Task OnInitializedAsync()
    {
        var logger = LoggerFactory.CreateLogger<BillOfMaterials>();
        logger.LogTrace("Loading Bill of Materials");

        _setBrickInfo.Clear();
        _setMinifigInfo.Clear();

        _ownedSets = (await Api.GetMyOwnedSetsAsync())?.ToList() ?? [];

        if (_setId != null)
        {
            _selectedOwnedSet = _ownedSets.FirstOrDefault(s => s.SetId == _setId);

            if (!int.TryParse(_setIndex, out var setIndex))
                setIndex = 0;
            _currentSetIndex = setIndex;
            _setIndex = setIndex.ToString();
            _ownedInstances = _selectedOwnedSet?.Instances.Select(i => i.SetIndex).ToList() ?? [];

            _pageTitle = $"{_setId}-{_currentSetIndex} - Bill of Materials";
            StateHasChanged();

            var bom = await Api.GetBomAsync(_setId, setIndex);
            if (bom == null)
            {
                Nav.NavigateTo("/not-found");
                return;
            }

            _setBrickInfo = bom.Bricks.Select(b => new SetBrickInfo
            {
                Brick = b,
                SetStock = b.SetStock,
                LooseStock = b.LooseStock
            }).ToList();

            _setMinifigInfo = bom.Minifigs.Select(m => new SetMinifigInfo
            {
                Minifig = m,
                OwnedStock = m.OwnedStock
            }).ToList();

            // Load each fig's parts (with this copy's owned stock) for the expandable child grid.
            foreach (var mi in _setMinifigInfo)
            {
                var bricks = await Api.GetMinifigBricksInBomAsync(_setId, setIndex, mi.Minifig.MinifigId);
                mi.BomBricks = (bricks ?? [])
                    .Select(b => new SetBrickInfo { Brick = b, SetStock = b.SetStock, LooseStock = b.LooseStock })
                    .ToList();
            }
        }

        _isLoading = false;
        StateHasChanged();
        logger.LogTrace("Loading Sets Complete");
    }

    private async Task ChangeSet(ApiClient.MyOwnedSetDto set)
    {
        _setId = set.SetId;
        _selectedOwnedSet = set;
        navigationManager.NavigateTo($"/bom/{_setId}/0");
        await OnInitializedAsync();
    }

    private async Task ChangeIndex(int setIndex)
    {
        _currentSetIndex = setIndex;
        _setIndex = setIndex.ToString();
        navigationManager.NavigateTo($"/bom/{_setId}/{_setIndex}");
        await OnInitializedAsync();
    }

    private bool SetBrickFilterFunc(SetBrickInfo setBrickInfo) => SetBrickFilter(setBrickInfo);

    private bool SetBrickFilter(SetBrickInfo setBrickInfo)
    {
        if (_showMissing && setBrickInfo.Brick.Count <= setBrickInfo.SetStock)
            return false;

        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (setBrickInfo.Brick.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (setBrickInfo.Brick.PartNum.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (setBrickInfo.Brick.ColorName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        return false;
    }

    private bool SetMinifigFilterFunc(SetMinifigInfo setMinifigInfo) => SetMinifigFilter(setMinifigInfo);

    private bool SetMinifigFilter(SetMinifigInfo setMinifigInfo)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (setMinifigInfo.Minifig.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (setMinifigInfo.Minifig.MinifigId.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private Task OpenImagePopup(string id, string name, string? imgUrl)
    {
        var imagePopup = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true };
        var parameters = new DialogParameters<ImagePopup>
        {
            { x => x._id, id },
            { x => x._name, name },
            { x => x._imgUrl, imgUrl }
        };
        return DialogService.ShowAsync<ImagePopup>("Image Popup", parameters, imagePopup);
    }

    private Task OpenColorPopup(string hex, string name)
    {
        var colorPopup = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true };
        var parameters = new DialogParameters<ColorPopup>
        {
            { x => x._hexColor, hex },
            { x => x._name, name },
        };
        return DialogService.ShowAsync<ColorPopup>("Color Popup", parameters, colorPopup);
    }

    private Task OpenErrorPopup(string errorMessage)
    {
        var errorPopup = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true };
        var parameters = new DialogParameters<ErrorPopup>
        {
            { x => x._errorMessage, errorMessage }
        };
        return DialogService.ShowAsync<ErrorPopup>("Error Popup", parameters, errorPopup);
    }

    async Task UpdateBrick(SetBrickInfo setBrickInfo)
    {
        if (setBrickInfo.LooseStock < 0)
        {
            setBrickInfo.LooseStock = 0;
            await OpenErrorPopup("Cannot set personal stock to less than 0");
            return;
        }

        if (setBrickInfo.SetStock < 0)
        {
            setBrickInfo.SetStock = 0;
            await OpenErrorPopup("Cannot set stock used to less than 0");
            return;
        }

        if (AuthService.CurrentUser == null)
        {
            await OpenErrorPopup("You must be logged in to save stock changes.");
            return;
        }

        if (_setId != null)
        {
            if (!await Api.UpdateSetBrickStockAsync(_setId, _currentSetIndex, setBrickInfo.Brick.PartNum, setBrickInfo.Brick.ColorId, setBrickInfo.SetStock))
                await OpenErrorPopup("Failed to save set stock. The set may not be in your inventory yet — try re-adding it.");
            if (!await Api.UpdateLooseBrickStockAsync(_setId, _currentSetIndex, setBrickInfo.Brick.PartNum, setBrickInfo.Brick.ColorId, setBrickInfo.LooseStock))
                await OpenErrorPopup("Failed to save loose brick stock.");
        }

        StateHasChanged();
    }

    async Task UpdateMinifig(SetMinifigInfo setMinifigInfo)
    {
        if (AuthService.CurrentUser == null)
        {
            await OpenErrorPopup("You must be logged in to save stock changes.");
            return;
        }
        if (_setId != null && !await Api.UpdateBomMinifigStockAsync(_setId, _currentSetIndex, setMinifigInfo.Minifig.MinifigId, setMinifigInfo.OwnedStock))
            await OpenErrorPopup("Failed to save minifig stock.");
        StateHasChanged();
    }

    private async Task SaveSetBrickOwnedStock(SetBrickInfo info, int newValue)
    {
        if (AuthService.CurrentUser == null || _setId == null) return;
        info.SetStock = newValue;
        if (!await Api.UpdateSetBrickStockAsync(_setId, _currentSetIndex, info.Brick.PartNum, info.Brick.ColorId, newValue))
            _ = OpenErrorPopup("Failed to save set stock. The set may not be in your inventory yet.");
        StateHasChanged();
    }

    private async Task SaveBrickOwnedStock(SetBrickInfo info, int newValue)
    {
        if (AuthService.CurrentUser == null || _setId == null) return;
        info.LooseStock = newValue;
        if (!await Api.UpdateLooseBrickStockAsync(_setId, _currentSetIndex, info.Brick.PartNum, info.Brick.ColorId, newValue))
            _ = OpenErrorPopup("Failed to save loose brick stock.");
        StateHasChanged();
    }

    private async Task SaveMinifigOwnedStock(SetMinifigInfo info, int newValue)
    {
        if (AuthService.CurrentUser == null || _setId == null) return;
        info.OwnedStock = newValue;
        if (!await Api.UpdateBomMinifigStockAsync(_setId, _currentSetIndex, info.Minifig.MinifigId, newValue))
            _ = OpenErrorPopup("Failed to save minifig stock.");
        StateHasChanged();
    }

    private async Task SaveMinifigBrickOwnedStock(SetMinifigInfo minifig, SetBrickInfo info, int newValue)
    {
        if (AuthService.CurrentUser == null || _setId == null) return;
        info.SetStock = newValue;
        if (!await Api.UpdateBomMinifigBrickStockAsync(
                _setId, _currentSetIndex, minifig.Minifig.MinifigId, info.Brick.PartNum, info.Brick.ColorId, newValue))
            _ = OpenErrorPopup("Failed to save minifig part stock.");
        StateHasChanged();
    }

    async Task MoveBrickStock(Direction dir, SetBrickInfo setBrickInfo)
    {
        if (dir == Direction.left)
        {
            if (setBrickInfo.LooseStock < setBrickInfo.MoveCount)
            {
                await OpenErrorPopup("Not enough personal inventory to move to set");
                return;
            }
            setBrickInfo.LooseStock -= setBrickInfo.MoveCount;
            setBrickInfo.SetStock += setBrickInfo.MoveCount;
            await UpdateBrick(setBrickInfo);
        }
        else if (dir == Direction.right)
        {
            if (setBrickInfo.SetStock < setBrickInfo.MoveCount)
            {
                await OpenErrorPopup("Not enough set stock to return to personal inventory");
                return;
            }
            setBrickInfo.SetStock -= setBrickInfo.MoveCount;
            setBrickInfo.LooseStock += setBrickInfo.MoveCount;
            await UpdateBrick(setBrickInfo);
        }
    }

    enum Direction { left, right }

    protected void OpenBuildingInstructions(string url)
    {
        JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    public class SetBrickInfo
    {
        public ApiClient.BomBrickDto Brick { get; set; } = null!;
        public int SetStock { get; set; }
        public int LooseStock { get; set; }
        public int MoveCount { get; set; } = 0;
    }

    public class SetMinifigInfo
    {
        public ApiClient.BomMinifigDto Minifig { get; set; } = null!;
        public int OwnedStock { get; set; }
        public List<SetBrickInfo> BomBricks { get; set; } = [];
    }
}
