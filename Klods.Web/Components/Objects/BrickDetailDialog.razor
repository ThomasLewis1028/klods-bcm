@inject ApiClient Api
@inject AuthService AuthService
@inject ImageStorageService ImageStorage
@inject ISnackbar Snackbar
@using Klods.Services
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Style="min-width: 300px;">
            <MudImage Src="@ImageStorage.ResolveUrl(Brick.PartImg)" Alt="@Brick.Name"
                      Style="width: 200px; height: 200px; object-fit: contain;" Class="rounded-lg"/>
            <MudText Typo="Typo.h6" Align="Align.Center">@Brick.Name</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Brick.PartNum</MudText>
            @if (Brick.HexColor != null)
            {
                <MudChip T="string" Style="@ColorHelper.ColorChipStyle(Brick.HexColor)">@Brick.ColorName</MudChip>
            }

            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                <MudText>My stock:</MudText>
                <MudNumericField T="int" @bind-Value="_stock" Min="0" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Style="max-width: 110px;"
                                 Disabled="@(AuthService.CurrentUser == null)"/>
                <MudButton OnClick="SaveStock" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(AuthService.CurrentUser == null)">Save</MudButton>
            </MudStack>

            <MudDivider Class="my-2" FlexItem="true"/>
            <MudText Typo="Typo.subtitle2" Style="align-self:flex-start;">Used in @_total set(s)</MudText>

            <MudTextField T="string" Value="_query" ValueChanged="OnSearch" Immediate="true" DebounceInterval="350"
                          Placeholder="Search sets by id or name…" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Clearable="true" Style="width:100%;"/>

            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small"/>
            }
            else if (_items.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No sets match your search.</MudText>
            }
            else
            {
                <MudList T="string" Dense="true" Style="width:100%;">
                    @foreach (var s in _items)
                    {
                        <MudListItem T="string">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudImage class="rounded-2" Elevation="1" Src="@ImageStorage.ResolveUrl(s.SetImg)"
                                          Height="36" Width="36" Style="object-fit:contain; flex-shrink:0;"/>
                                <MudStack Spacing="0" Style="flex:1; min-width:0;">
                                    <MudText Typo="Typo.body2" Style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@s.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@s.SetId</MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">&times;@s.Count</MudText>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
                @if (_totalPages > 1)
                {
                    <MudStack Row Justify="Justify.Center" Class="mt-1" Style="width:100%;">
                        <MudPagination Color="Color.Primary" Count="_totalPages" Selected="_page"
                                       SelectedChanged="OnPageChanged" Size="Size.Small"/>
                    </MudStack>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ApiClient.BrickCatalogViewDto Brick { get; set; } = null!;

    private const int SetPageSize = 6;

    private int _stock;
    private string _query = "";
    private int _page = 1;
    private int _total;
    private int _totalPages = 1;
    private List<ApiClient.SetForBrickDto> _items = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _stock = (await Api.GetMyBrickStockAsync(Brick.PartNum, Brick.ColorId ?? ""))?.Stock ?? 0;
        await LoadSetsAsync();
    }

    private async Task LoadSetsAsync()
    {
        _loading = true;
        StateHasChanged();
        var page = await Api.GetSetsForBrickPageAsync(
            Brick.PartNum, Brick.ColorId ?? "", _query.Trim(), _page - 1, SetPageSize);
        _items = page?.Items ?? [];
        _total = page?.Total ?? 0;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)SetPageSize));
        _loading = false;
        StateHasChanged();
    }

    private Task OnSearch(string? value) { _query = value ?? ""; _page = 1; return LoadSetsAsync(); }
    private Task OnPageChanged(int page) { _page = page; return LoadSetsAsync(); }

    private async Task SaveStock()
    {
        if (AuthService.CurrentUser == null) return;
        if (await Api.UpsertBrickStockAsync(Brick.PartNum, Brick.ColorId ?? "", _stock))
            Snackbar.Add("Stock updated.", Severity.Success);
        else
            Snackbar.Add("Failed to update stock.", Severity.Error);
    }
}
