@inject ApiClient Api
@inject AuthService AuthService
@inject ImageStorageService ImageStorage
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<MudDialog>
    <DialogContent>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="3" Class="pb-3 mb-2"
                  Style="border-bottom: 1px solid var(--mud-palette-divider);">
            <MudImage class="cursor-pointer rounded-2" Elevation="2"
                      Src="@ImageStorage.ResolveUrl(SetImg)" Height="56" Width="56"
                      ObjectFit="ObjectFit.Contain"
                      @onclick="() => OpenImagePopup(SetId, _setName, ImageStorage.ResolveUrl(SetImg))"/>
            <MudStack Spacing="0" Style="flex:1; min-width:0;">
                <MudText Typo="Typo.h6" Style="font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@_setName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@SetId</MudText>
                @if (!_isLoading)
                {
                    <div style="margin-top:6px; max-width:280px; display:flex; flex-direction:column; gap:3px;">
                        <CompletenessBar Percent="@_percent" Status="@_status" Label="@($"{_percent}% assembled")"/>
                        <span class="cstatus cstatus-@_status" style="font-size:.72rem;">@_percent% · @StatusWord(_status)</span>
                    </div>
                }
            </MudStack>
            @if (_ownedInstances.Count > 1)
            {
                <MudSelect T="int" Value="_currentSetIndex" ValueChanged="ChangeIndex"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                           Label="Copy" Style="min-width: 120px; max-width: 140px;">
                    @foreach (var idx in _ownedInstances)
                    {
                        <MudSelectItem Value="@idx">Copy #@idx</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (!string.IsNullOrEmpty(_manualUrl))
            {
                <MudButton StartIcon="@Icons.Material.Filled.MenuBook" Variant="Variant.Text"
                           OnClick="() => OpenBuildingInstructions(_manualUrl)" Style="flex-shrink: 0;">
                    Instructions
                </MudButton>
            }
        </MudStack>
        <div style="min-height: 60vh; max-height: 72vh; overflow-y: auto;">
        @if (_isLoading)
        {
            <div style="display: flex; justify-content: center; align-items: center; height: 60vh;">
                <MudProgressCircular Indeterminate="true" Size="Size.Large"/>
            </div>
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                @* Brick Tab *@
                <MudTabPanel Text="Bricks">
                    <MudDataGrid T="SetBrickInfo" Items="@_setBrickInfo.OrderBy(b => b.Brick.PartNum)"
                                 SortMode="@SortMode.Multiple" EditMode="DataGridEditMode.Cell"
                                 QuickFilter="SetBrickFilterFunc" ReadOnly="false" Bordered="false" Dense="true">
                        <ToolBarContent>
                            <MudText Typo="Typo.body1">Missing
                                Pieces: @_setBrickInfo.Sum(sb => Math.Max(0, sb.Brick.Count - sb.SetStock))
                            </MudText>
                            <MudSpacer/>
                            <MudSwitch @bind-Value="_showMissing" UncheckedColor="Color.Default" Color="Color.Error"
                                       Label="Show Missing" LabelPlacement="Placement.Start"/>
                            <MudSpacer/>
                            <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start"
                                          Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium" Class="mt-0"/>
                        </ToolBarContent>
                        <Columns>
                            <TemplateColumn Title="Image" Editable="false">
                                <CellTemplate>
                                    <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                              Src="@ImageStorage.ResolveUrl(context.Item.Brick.PartImg)" Height="50"
                                              @onclick="() => OpenImagePopup(context.Item.Brick.PartNum, context.Item.Brick.Name, ImageStorage.ResolveUrl(context.Item.Brick.PartImg))"/>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Brick.PartNum" Title="Brick Id" Editable="false"/>
                            <PropertyColumn Property="x => x.Brick.Name" Title="Name" Editable="false"/>
                            <TemplateColumn Title="Color" SortBy="x => x.Brick.ColorId" Sortable="true" Editable="false">
                                <CellTemplate>
                                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
                                        @if (context.Item.Brick.HexColor != null)
                                        {
                                            <MudChip T="string" OnClick="() => OpenColorPopup(context.Item.Brick.HexColor, context.Item.Brick.ColorName)"
                                                     Style="@ColorHelper.ColorChipStyle(context.Item.Brick.HexColor)">@context.Item.Brick.ColorName</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default">N/A</MudChip>
                                        }
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Need (Spare)" Editable="false"
                                            SortBy="x => x.Brick.Count + x.Brick.SpareCount" Sortable="true">
                                <CellTemplate>
                                    <MudStack Row Spacing="1">
                                        @{ var stock = context.Item.SetStock; }
                                        @if (context.Item.Brick.Count <= stock)
                                        {
                                            <MudText Color="@Color.Success">@context.Item.Brick.Count</MudText>
                                        }
                                        else if (context.Item.Brick.Count - stock <= context.Item.LooseStock)
                                        {
                                            <MudText Color="@Color.Warning">@context.Item.Brick.Count</MudText>
                                        }
                                        else
                                        {
                                            <MudText Color="@Color.Error">@context.Item.Brick.Count</MudText>
                                        }
                                        @if (context.Item.Brick.SpareCount > 0)
                                        {
                                            <MudText Style="padding: -10px">(@context.Item.Brick.SpareCount)</MudText>
                                        }
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Stock Used" Editable="false" SortBy="x => x.SetStock">
                                <CellTemplate>
                                    <MudNumericField T="int" Value="@context.Item.SetStock"
                                                     ValueChanged="@(v => SaveSetBrickOwnedStock(context.Item, v))"
                                                     Min="0" Disabled="@(AuthService.CurrentUser == null)"
                                                     Variant="Variant.Text"/>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Move Stock" Editable="false">
                                <CellTemplate>
                                    <MudStack Row Spacing="0">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowLeft"
                                                       OnClick="() => MoveBrickStock(Direction.left, context.Item)"/>
                                        <MudNumericField Variant="Variant.Outlined" Min="0" @bind-Value="context.Item.MoveCount"/>
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowRight"
                                                       OnClick="() => MoveBrickStock(Direction.right, context.Item)"/>
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="My Stock" Editable="false" SortBy="x => x.LooseStock">
                                <CellTemplate>
                                    <MudNumericField T="int" Value="@context.Item.LooseStock"
                                                     ValueChanged="@(v => SaveBrickOwnedStock(context.Item, v))"
                                                     Min="0" Disabled="@(AuthService.CurrentUser == null)"
                                                     Variant="Variant.Text"/>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="SetBrickInfo"/>
                        </PagerContent>
                    </MudDataGrid>
                </MudTabPanel>

                @* Minifigure Tab *@
                <MudTabPanel Text="Minifigures" Disabled="@(_setMinifigInfo.Count == 0)">
                    <MudDataGrid T="SetMinifigInfo" Items="@_setMinifigInfo.OrderBy(b => b.Minifig.MinifigId)"
                                 SortMode="@SortMode.Multiple" EditMode="DataGridEditMode.Cell"
                                 QuickFilter="SetMinifigFilterFunc" ReadOnly="false" Dense="true">
                        <ToolBarContent>
                            <MudSpacer/>
                            <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start"
                                          Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium" Class="mt-0"/>
                        </ToolBarContent>
                        <Columns>
                            <HierarchyColumn/>
                            <TemplateColumn Title="Image" Editable="false">
                                <CellTemplate>
                                    <MudImage class="cursor-pointer rounded-2" Elevation="2"
                                              Src="@ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl)" Height="50"
                                              @onclick="() => OpenImagePopup(context.Item.Minifig.MinifigId, context.Item.Minifig.Name, ImageStorage.ResolveUrl(context.Item.Minifig.ImgUrl))"/>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Minifig.MinifigId" Title="Minifig Id" Editable="false"/>
                            <PropertyColumn Property="x => x.Minifig.Name" Title="Name" Editable="false"/>
                            <PropertyColumn Property="x => x.Minifig.Count" Title="Needed" Editable="false"/>
                            <TemplateColumn Title="My Stock" Editable="false" SortBy="x => x.OwnedStock">
                                <CellTemplate>
                                    <MudNumericField T="int" Value="@context.Item.OwnedStock"
                                                     ValueChanged="@(v => SaveMinifigOwnedStock(context.Item, v))"
                                                     Min="0" Disabled="@(AuthService.CurrentUser == null)"
                                                     Variant="Variant.Text"/>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <ChildRowContent Context="minifigContext">
                            <MudCard>
                                <MudDataGrid T="SetBrickInfo" Items="@minifigContext.Item.BomBricks" Dense="true">
                                    <Columns>
                                        <TemplateColumn Title="Image">
                                            <CellTemplate>
                                                <MudImage class="cursor-pointer rounded-3" Elevation="2"
                                                          Src="@ImageStorage.ResolveUrl(context.Item.Brick.PartImg)" Height="50"
                                                          @onclick="() => OpenImagePopup(context.Item.Brick.PartNum, context.Item.Brick.Name, ImageStorage.ResolveUrl(context.Item.Brick.PartImg))"/>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Title="Brick Id" Property="x => x.Brick.PartNum"/>
                                        <PropertyColumn Title="Name" Property="x => x.Brick.Name"/>
                                        <TemplateColumn Title="Need" Editable="false" SortBy="x => x.Brick.Count" Sortable="true">
                                            <CellTemplate>
                                                <MudText>@context.Item.Brick.Count</MudText>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Stock Used">
                                            <CellTemplate>
                                                <MudNumericField T="int" Value="@context.Item.SetStock"
                                                                 ValueChanged="@(v => SaveMinifigBrickOwnedStock(minifigContext.Item, context.Item, v))"
                                                                 Min="0" Disabled="@(AuthService.CurrentUser == null)"
                                                                 Variant="Variant.Text"/>
                                            </CellTemplate>
                                        </TemplateColumn>
                                    </Columns>
                                </MudDataGrid>
                            </MudCard>
                        </ChildRowContent>
                        <PagerContent>
                            <MudDataGridPager T="SetMinifigInfo"/>
                        </PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
            </MudTabs>
        }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string SetId { get; set; } = null!;
    [Parameter] public string? SetImg { get; set; }
    [Parameter] public int? SetIndex { get; set; }

    private List<SetBrickInfo> _setBrickInfo = new();
    private List<SetMinifigInfo> _setMinifigInfo = new();
    private List<int> _ownedInstances = new();
    private string _setName = "";
    private string? _manualUrl;
    private int _percent;
    private string _status = "short";

    private static string StatusWord(string status) => status switch
    {
        "complete"    => "Complete",
        "completable" => "Buildable",
        _             => "Missing parts",
    };
    private string _searchString = "";
    private bool _showMissing;
    private bool _isLoading = true;
    private int _currentSetIndex;

    protected override async Task OnInitializedAsync()
    {
        // A specific copy may be supplied (from My Sets); otherwise open the first owned copy.
        if (SetIndex.HasValue)
        {
            _currentSetIndex = SetIndex.Value;
        }
        else
        {
            var owned = await Api.GetMyOwnedSetsAsync();
            var instances = owned?.FirstOrDefault(s => s.SetId == SetId)?.Instances;
            if (instances is not { Count: > 0 })
            {
                Snackbar.Add("You don't own a copy of this set.", Severity.Warning);
                _isLoading = false;
                return;
            }
            _currentSetIndex = instances.Min(i => i.SetIndex);
        }

        await LoadBomAsync();
    }

    private async Task LoadBomAsync()
    {
        _isLoading = true;
        StateHasChanged();

        _setBrickInfo.Clear();
        _setMinifigInfo.Clear();

        var bom = await Api.GetBomAsync(SetId, _currentSetIndex);
        if (bom == null)
        {
            Snackbar.Add("Could not load the bill of materials for this set.", Severity.Error);
            _isLoading = false;
            StateHasChanged();
            return;
        }

        _setName = bom.SetName;
        _manualUrl = bom.ManualUrl;
        _ownedInstances = bom.OwnedInstances;
        _percent = bom.Percent;
        _status = bom.Status;

        _setBrickInfo = bom.Bricks.Select(b => new SetBrickInfo
        {
            Brick = b, SetStock = b.SetStock, LooseStock = b.LooseStock
        }).ToList();

        _setMinifigInfo = bom.Minifigs.Select(m => new SetMinifigInfo
        {
            Minifig = m, OwnedStock = m.OwnedStock
        }).ToList();

        foreach (var mi in _setMinifigInfo)
        {
            var bricks = await Api.GetMinifigBricksInBomAsync(SetId, _currentSetIndex, mi.Minifig.MinifigId);
            mi.BomBricks = (bricks ?? [])
                .Select(b => new SetBrickInfo { Brick = b, SetStock = b.SetStock, LooseStock = b.LooseStock })
                .ToList();
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task ChangeIndex(int setIndex)
    {
        _currentSetIndex = setIndex;
        await LoadBomAsync();
    }

    private bool SetBrickFilterFunc(SetBrickInfo info)
    {
        if (_showMissing && info.Brick.Count <= info.SetStock)
            return false;
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        if (info.Brick.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (info.Brick.PartNum.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (info.Brick.ColorName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        return false;
    }

    private bool SetMinifigFilterFunc(SetMinifigInfo info)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        if (info.Minifig.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (info.Minifig.MinifigId.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    // Re-pull just the copy's completeness so the header bar tracks edits live (no grid rebuild).
    private async Task RefreshCompletenessAsync()
    {
        var comp = await Api.GetBomCompletenessAsync(SetId, _currentSetIndex);
        if (comp != null)
        {
            _percent = comp.Percent;
            _status = comp.Status;
            StateHasChanged();
        }
    }

    private async Task SaveSetBrickOwnedStock(SetBrickInfo info, int newValue)
    {
        if (AuthService.CurrentUser == null) return;
        info.SetStock = newValue;
        if (!await Api.UpdateSetBrickStockAsync(SetId, _currentSetIndex, info.Brick.PartNum, info.Brick.ColorId, newValue))
            Snackbar.Add("Failed to save set stock. The set may not be in your inventory yet.", Severity.Error);
        StateHasChanged();
        await RefreshCompletenessAsync();
    }

    private async Task SaveBrickOwnedStock(SetBrickInfo info, int newValue)
    {
        if (AuthService.CurrentUser == null) return;
        info.LooseStock = newValue;
        if (!await Api.UpdateLooseBrickStockAsync(SetId, _currentSetIndex, info.Brick.PartNum, info.Brick.ColorId, newValue))
            Snackbar.Add("Failed to save loose brick stock.", Severity.Error);
        StateHasChanged();
        await RefreshCompletenessAsync();
    }

    private async Task SaveMinifigOwnedStock(SetMinifigInfo info, int newValue)
    {
        if (AuthService.CurrentUser == null) return;
        info.OwnedStock = newValue;
        if (!await Api.UpdateBomMinifigStockAsync(SetId, _currentSetIndex, info.Minifig.MinifigId, newValue))
            Snackbar.Add("Failed to save minifig stock.", Severity.Error);
        StateHasChanged();
        await RefreshCompletenessAsync();
    }

    private async Task SaveMinifigBrickOwnedStock(SetMinifigInfo minifig, SetBrickInfo info, int newValue)
    {
        if (AuthService.CurrentUser == null) return;
        info.SetStock = newValue;
        if (!await Api.UpdateBomMinifigBrickStockAsync(
                SetId, _currentSetIndex, minifig.Minifig.MinifigId, info.Brick.PartNum, info.Brick.ColorId, newValue))
            Snackbar.Add("Failed to save minifig part stock.", Severity.Error);
        StateHasChanged();
        await RefreshCompletenessAsync();
    }

    private async Task MoveBrickStock(Direction dir, SetBrickInfo info)
    {
        if (AuthService.CurrentUser == null) return;

        if (dir == Direction.left)
        {
            if (info.LooseStock < info.MoveCount)
            {
                Snackbar.Add("Not enough personal inventory to move to set.", Severity.Warning);
                return;
            }
            info.LooseStock -= info.MoveCount;
            info.SetStock += info.MoveCount;
        }
        else
        {
            if (info.SetStock < info.MoveCount)
            {
                Snackbar.Add("Not enough set stock to return to personal inventory.", Severity.Warning);
                return;
            }
            info.SetStock -= info.MoveCount;
            info.LooseStock += info.MoveCount;
        }

        var setOk = await Api.UpdateSetBrickStockAsync(SetId, _currentSetIndex, info.Brick.PartNum, info.Brick.ColorId, info.SetStock);
        var looseOk = await Api.UpdateLooseBrickStockAsync(SetId, _currentSetIndex, info.Brick.PartNum, info.Brick.ColorId, info.LooseStock);
        if (!setOk || !looseOk)
            Snackbar.Add("Failed to move stock.", Severity.Error);
        StateHasChanged();
        await RefreshCompletenessAsync();
    }

    private Task OpenImagePopup(string id, string name, string? imgUrl) =>
        DialogService.ShowAsync<ImagePopup>("Image Popup",
            new DialogParameters<ImagePopup> { { x => x._id, id }, { x => x._name, name }, { x => x._imgUrl, imgUrl } },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });

    private Task OpenColorPopup(string? hex, string? name)
    {
        if (hex == null || name == null) return Task.CompletedTask;
        return DialogService.ShowAsync<ColorPopup>("Color Popup",
            new DialogParameters<ColorPopup> { { x => x._hexColor, hex }, { x => x._name, name } },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
    }

    private void OpenBuildingInstructions(string url) => JsRuntime.InvokeVoidAsync("open", url, "_blank");

    private enum Direction { left, right }

    public class SetBrickInfo
    {
        public ApiClient.BomBrickDto Brick { get; set; } = null!;
        public int SetStock { get; set; }
        public int LooseStock { get; set; }
        public int MoveCount { get; set; }
    }

    public class SetMinifigInfo
    {
        public ApiClient.BomMinifigDto Minifig { get; set; } = null!;
        public int OwnedStock { get; set; }
        public List<SetBrickInfo> BomBricks { get; set; } = [];
    }
}
