@inject ApiClient Api
@inject AuthService AuthService
@inject ImageStorageService ImageStorage
@inject IJSRuntime JsRuntime
@inject IDialogService DialogService
@using Klods.Services
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Style="min-width: 280px;">
            <MudImage Src="@ImageStorage.ResolveUrl(Set.SetImg)" Alt="@Set.Name"
                      Style="max-width: 100%; max-height: 240px; width: auto; height: auto; object-fit: contain;" Class="rounded-lg"/>
            <MudText Typo="Typo.h6" Align="Align.Center">@Set.Name</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Set.SetId &middot; @Set.ReleaseYear &middot; @Set.NumBricks.ToString("N0") pcs
            </MudText>
            @if (!string.IsNullOrEmpty(Set.ThemeName))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@Set.ThemeName</MudChip>
            }

            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                <MudText>Owned:</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                               Disabled="@(_owned == 0 || AuthService.CurrentUser == null)" OnClick="Decrement"/>
                <MudText Typo="Typo.h6" Style="min-width: 32px; text-align: center;">@_owned</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                               Disabled="@(AuthService.CurrentUser == null)" OnClick="Increment"/>
            </MudStack>

            <MudStack Row Spacing="1" Justify="Justify.Center">
                <MudButton StartIcon="@Icons.Material.Filled.MenuBook" Variant="Variant.Text" OnClick="OpenManual">
                    Building instructions
                </MudButton>
                @if (BomInstanceIndex.HasValue)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.FormatListBulleted" Variant="Variant.Text"
                               Color="Color.Primary" OnClick="OpenBom">
                        Bill of Materials
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ApiClient.SetCatalogSearchDto Set { get; set; } = null!;
    [Parameter] public int Owned { get; set; }
    [Parameter] public int? BomInstanceIndex { get; set; }

    private int _owned;

    protected override void OnInitialized() => _owned = Owned;

    private async Task Increment()
    {
        if (AuthService.CurrentUser == null) return;
        if (await Api.AddOwnedSetAsync(Set.SetId)) { _owned++; StateHasChanged(); }
    }

    private async Task Decrement()
    {
        if (AuthService.CurrentUser == null || _owned == 0) return;
        if (await Api.DeleteLastOwnedSetAsync(Set.SetId)) { _owned--; StateHasChanged(); }
    }

    private void OpenManual() => JsRuntime.InvokeVoidAsync("open", Set.ManualUrl, "_blank");

    private Task OpenBom()
    {
        var parameters = new DialogParameters<BomDialog>
        {
            { x => x.SetId, Set.SetId },
            { x => x.SetImg, Set.SetImg },
            { x => x.SetIndex, BomInstanceIndex ?? 0 }
        };
        return DialogService.ShowAsync<BomDialog>("Bill of Materials", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(_owned));
}
