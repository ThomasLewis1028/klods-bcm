@inject ApiClient Api
@inject ImageStorageService ImageStorage
@using Klods.Services
@using Color = MudBlazor.Color

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Choose Profile Picture</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Style="min-height: 360px;">
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.PersonOff" OnClick="Remove">
                Remove current picture
            </MudButton>

            <MudTextField T="string" Value="_query" ValueChanged="OnQueryChanged"
                          Immediate="true" DebounceInterval="350"
                          Placeholder="Search minifigures by name or number…"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Clearable="true"/>

            @if (_searching)
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-6"><MudProgressCircular Indeterminate="true"/></MudStack>
            }
            else if (!_hasSearched)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="pa-6">
                    Start typing to find a minifigure.
                </MudText>
            }
            else if (_results.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="pa-6">
                    No minifigures match “@_query”.
                </MudText>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 12px; max-height: 360px; overflow-y: auto; padding: 4px;">
                    @foreach (var fig in _results)
                    {
                        var f = fig;
                        <div @onclick="() => Select(f)"
                             style="cursor: pointer; border-radius: 12px; padding: 8px; display: flex; flex-direction: column; align-items: center; gap: 6px;">
                            <MudImage Src="@ImageStorage.ResolveUrl(f.ImgUrl)" Alt="@f.Name"
                                      Style="width: 60px; height: 60px; object-fit: contain;"/>
                            <MudText Typo="Typo.caption"
                                     Style="text-align: center; line-height: 1.2; max-width: 80px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @f.Name
                            </MudText>
                        </div>
                    }
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _query = "";
    private bool _hasSearched;
    private bool _searching;
    private List<ApiClient.MinifigSearchDto> _results = [];

    /// <summary>Result of the picker: either remove the picture, or set it to <see cref="ImgUrl"/>.</summary>
    public record PickResult(bool Remove, string? ImgUrl);

    private async Task OnQueryChanged(string value)
    {
        _query = value ?? "";
        var q = _query.Trim();
        _hasSearched = q.Length >= 2;

        if (!_hasSearched)
        {
            _results = [];
            _searching = false;
            StateHasChanged();
            return;
        }

        _searching = true;
        StateHasChanged();
        _results = (await Api.SearchMinifigsCatalogAsync(q))?.ToList() ?? [];
        _searching = false;
        StateHasChanged();
    }

    private void Select(ApiClient.MinifigSearchDto fig) => MudDialog.Close(DialogResult.Ok(new PickResult(false, fig.ImgUrl)));
    private void Remove() => MudDialog.Close(DialogResult.Ok(new PickResult(true, null)));
    private void Cancel() => MudDialog.Cancel();
}
