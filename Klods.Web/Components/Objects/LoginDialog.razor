@inject AuthService AuthService
@inject ApiClient Api
@inject NavigationManager Nav
@inject IDialogService DialogService
@using Color = MudBlazor.Color
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage LocalStorage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" Style="vertical-align: middle;"/>
            @(_isRegister ? "Create Account" : "Sign In")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_errorMessage != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }
            @if (_pendingApproval)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Your account is pending approval. An admin must activate it before you can sign in.
                </MudAlert>
            }

            @if (!_isRegister && _providers.Length > 0)
            {
                <MudStack Spacing="2">
                    @foreach (var provider in _providers)
                    {
                        var p = provider;
                        <MudButton FullWidth="true" Variant="Variant.Outlined"
                                   StartIcon="@ProviderIcon(p)"
                                   OnClick="@(() => SignInWithProvider(p))">
                            Continue with @p
                        </MudButton>
                    }
                </MudStack>
                <MudDivider>
                    <MudText Typo="Typo.caption" Style="opacity: 0.5; padding: 0 8px;">or</MudText>
                </MudDivider>
            }

            <MudTextField T="string" Label="Username" @bind-Value="_username"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                          Immediate="true" OnKeyDown="OnKeyDown"/>

            <MudTextField T="string" Label="Password" @bind-Value="_password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          Immediate="true" OnKeyDown="OnKeyDown"/>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Row="true" Justify="Justify.SpaceBetween" Style="width: 100%; padding: 0 8px 8px 8px;">
            <MudButton Variant="Variant.Text" OnClick="ToggleMode" Color="Color.Secondary">
                @(_isRegister ? "Already have an account?" : "Create an account")
            </MudButton>
            <MudStack Row="true" Spacing="1">
                <MudButton OnClick="Cancel">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">
                    @(_isRegister ? "Register" : "Login")
                </MudButton>
            </MudStack>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string[] _providers = [];
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _showPassword = false;
    private bool _isRegister = false;
    private string? _errorMessage;
    private bool _pendingApproval = false;

    protected override async Task OnInitializedAsync()
    {
        _providers = await Api.GetProvidersAsync() ?? [];
    }

    private async Task Submit()
    {
        _errorMessage = null;
        _pendingApproval = false;

        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Username and password are required.";
            return;
        }

        var (jwt, isPending) = _isRegister
            ? await Api.RegisterAsync(_username, _password)
            : await Api.LoginAsync(_username, _password);

        if (isPending)
        {
            _pendingApproval = true;
            return;
        }

        if (jwt is null)
        {
            _errorMessage = _isRegister ? "Username already taken." : "Invalid username or password.";
            return;
        }

        var profile = await Api.GetMyProfileAsync(jwt);
        if (profile is null) { _errorMessage = "Login succeeded but could not load profile."; return; }

        var user = new UserInfo(profile.UserId, profile.UserName, profile.Role,
            profile.ProfilePictureUrl, profile.PrimaryColor, profile.HasPassword, profile.FontScale);
        AuthService.SetSession(user, jwt);
        try { await LocalStorage.SetAsync("jwt", jwt); } catch { }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    private void ToggleMode()
    {
        _isRegister = !_isRegister;
        _errorMessage = null;
        _pendingApproval = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await Submit();
    }

    private void SignInWithProvider(string provider)
    {
        MudDialog.Cancel();
        Nav.NavigateTo(Api.ChallengeUrl(provider), forceLoad: true);
    }

    private static string ProviderIcon(string provider) => provider switch
    {
        "Google"    => Icons.Custom.Brands.Google,
        "Microsoft" => Icons.Custom.Brands.Microsoft,
        "Discord"   => Icons.Material.Filled.Chat,
        _           => Icons.Material.Filled.Login
    };
}
