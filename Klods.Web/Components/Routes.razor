@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Klods.Components.Objects
@inject AuthService AuthService
@inject ApiClient Api
@inject ThemeService ThemeService
@inject ProtectedLocalStorage LocalStorage
@inject IJSRuntime JS
@inject IDialogService DialogService
@implements IDisposable

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToNotAuthorized />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1"/>
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    // Font scale is a per-user preference (like primary color). Applying it means setting the root
    // html font-size (MudBlazor typography is rem-based), which needs JS — so it's centralized here,
    // above both layouts, rather than duplicated in each. On any auth change the scale follows the
    // signed-in user (or resets on sign-out); on any theme change we push it to the DOM.
    protected override void OnInitialized()
    {
        AuthService.OnChange += OnAuthChanged;
        ThemeService.OnChange += ApplyFontScale;
    }

    public void Dispose()
    {
        AuthService.OnChange -= OnAuthChanged;
        ThemeService.OnChange -= ApplyFontScale;
    }

    private void OnAuthChanged()
    {
        ThemeService.SetFontScale(AuthService.CurrentUser?.FontScale ?? ThemeService.DefaultFontScale);
        _ = MaybeShowTourAsync();
    }

    private bool _tourChecked;

    // Show the welcome tour once, the first time a real (non-placeholder) user with HasSeenTour==false appears.
    private async Task MaybeShowTourAsync()
    {
        var user = AuthService.CurrentUser;
        if (_tourChecked || user is null || user.UserId == 0 || user.HasSeenTour) return;
        _tourChecked = true;

        await InvokeAsync(async () =>
        {
            var dialog = await DialogService.ShowAsync<TourDialog>(null, new DialogOptions
            {
                MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false
            });
            await dialog.Result;
            await Api.MarkTourSeenAsync();
            if (AuthService.CurrentUser is not null)
                AuthService.UpdateCurrentUser(AuthService.CurrentUser with { HasSeenTour = true });
        });
    }

    private async void ApplyFontScale()
    {
        try
        {
            var pct = (int)Math.Round(ThemeService.FontScale * 100);
            await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "font-size", $"{pct}%");
        }
        catch { /* JS not available yet (pre-render) — reapplied on the next change */ }
    }

    // Restore the session once per circuit, above the router. The auth-state provider awaits this
    // (see AuthService.WaitForSessionRestoreAsync) so protected routes are never evaluated as
    // anonymous before the JWT is rehydrated from browser storage.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var storedJwt = await LocalStorage.GetAsync<string>("jwt");
            if (storedJwt.Success && !string.IsNullOrEmpty(storedJwt.Value))
            {
                // Bootstrap token so ApiClient can call the API.
                AuthService.SetSession(new UserInfo(0, "", "User", null, null, false), storedJwt.Value);
                var profile = await Api.GetMyProfileAsync();
                if (profile is not null)
                {
                    var user = new UserInfo(profile.UserId, profile.UserName, profile.Role,
                        profile.ProfilePictureUrl, profile.PrimaryColor, profile.HasPassword, profile.FontScale, profile.HasSeenTour);
                    AuthService.SetSession(user, storedJwt.Value);
                    ThemeService.SetPrimaryColor(profile.PrimaryColor ?? ThemeService.DefaultPrimaryColor);
                }
                else
                {
                    // Token invalid or API unreachable — clear it.
                    AuthService.Logout();
                    await LocalStorage.DeleteAsync("jwt");
                }
            }
        }
        catch { /* storage unavailable or tampered */ }
        finally { AuthService.MarkSessionRestored(); }
    }
}
