<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only tool: NOT part of Klods.slnx, so it never affects app/CI builds. -->
  <!-- Run with: dotnet run from this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Klods.TourCapture</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>

</Project>
